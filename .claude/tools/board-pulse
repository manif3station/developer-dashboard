#!/bin/bash
# board-pulse - one line naming every card that is not finished, wherever it sits.
#
# The owner's correction (2026-08-14): a heartbeat that watches two columns while
# the board has twenty tells you nothing about the eighteen you did not look at.
# Terminal columns are excluded because a finished card is not work; everything
# else is reported whether or not I think it is mine.
cd /home/mv/projects/developer-dashboard || exit 3
export PERL5LIB="$HOME/perl5/lib/perl5"
SKIP="discard release-to-pause admin-done"
out=""
for col in $(./bin/d2 tira.column.list --type ticket -o json 2>/dev/null \
  | python3 -P -c "import json,sys; print(' '.join(c['name'] for c in json.load(sys.stdin)))"); do
  case " $SKIP " in *" $col "*) continue;; esac
  # A column that cannot be read is NOT an empty column. Under load d2 can time
  # out and return nothing, and json.load on nothing raises - which printed a
  # traceback as the pulse's entire output, telling the reader neither the board
  # state nor that it had failed to look.
  raw=$(timeout 40 ./bin/d2 tira.ticket.list --column "$col" --refs-only -o json 2>/dev/null)
  if [ -z "$raw" ]; then
    out="$out $col=UNREADABLE"
    continue
  fi
  refs=$(printf '%s' "$raw" \
    | python3 -P -c "
import json,sys
try:
    d=json.load(sys.stdin)
    print(','.join(d if isinstance(d,list) else d.get('refs',[])))
except Exception:
    print('UNPARSEABLE')
" 2>/dev/null)
  [ -n "$refs" ] && out="$out $col=$refs"
done
sweep=$(.claude/tools/ft99-sweep 2>&1 | tail -1)
# Work stranded in a ticket sandbox is invisible to the board and to git status
# in the main checkout. Hours of written, compile-checked work sat uncommitted in
# one sandbox on 14 August and was found only by sweeping for it deliberately.
stranded=""
for d in /home/mv/dd-worktree-sandbox/*/; do
  [ -d "$d" ] || continue
  n=$(git -C "$d" status --porcelain 2>/dev/null | wc -l)
  [ "$n" -gt 0 ] && stranded="$stranded $(basename "$d")=$n"
done
[ -n "$stranded" ] && stranded=" | STRANDED:$stranded"
# The next action, not just the state. A pulse that only lists columns leaves the
# reader to decide what to do with them, and the failure this guards against
# (DD-544) is exactly the agent not deciding.
next=$(.claude/tools/next-action 2>&1 | head -1)
# The gate's state, from the artifacts rather than from a process query - a card
# sitting at a gate reads as stalled unless the pulse says whether the machine is
# still working on it.
gate=$(.claude/tools/gate-status 2>&1 | head -1)
echo "BOARD $(date +%H:%M) |${out:- (no open cards)} | $sweep | GATE: $gate$stranded | $next"
# The owner's words, 2026-08-14, after the agent stalled once too often. Kept
# verbatim: a reminder softened into the agent's own voice is one it can read
# past, and this one is meant to be unreadable-past.
echo "DO NOT STALL. CONTINUE WORKING. IF THERE IS A BLOCKER OR A QUESTION, RAISE IT AS A TICKET QUESTION - NEVER GO SILENT. BE PROACTIVE."
