#!/usr/bin/env bash
#
# Run this project's Tira policy bridge in the foreground, under a supervisor.
#
# WHY THIS EXISTS (DD-546)
#   Tira's own documentation is blunt about it: the agent RUNS the bridge and
#   keeps it running, and "a policy set without the bridge running is worse than
#   no policy, because it looks like cover". This project had no such process.
#   What it had was something that asked occasionally, so police's traffic was
#   only seen when somebody happened to ask at the right moment.
#
#   The first real run replayed 200 outstanding violations raised across a full
#   day. That is the measure of what was being missed, and none of it was
#   announced - a channel nobody listens on is silent in exactly the way a quiet
#   channel is.
#
# It is deliberately a foreground process: systemd owns the restarting, the
# logging and the supervision, because a hand-rolled loop with a nohup behind it
# is the thing that orphans and is never noticed again.

set -u

# The bridge is Tira's command and this only ever RUNS it. Nothing here reads or
# writes Tira's own files.
ROOT="/home/mv/projects/developer-dashboard"

# PERL5LIB is exported only by interactive shell init, and systemd reads no
# profile - the same environmental trap that made the FT99 sweep exit 3 on every
# scheduled run while passing by hand. Set it here rather than depending on it.
if [ -d "$HOME/perl5/lib/perl5" ]; then
    PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:$PERL5LIB}"
    export PERL5LIB
fi

# The working directory decides which board this resolves to: the layered runtime
# finds its config from the deepest .developer-dashboard above the CWD, and only
# the main checkout has one (DD-545).
cd "$ROOT" || {
    echo "tira-bridge: cannot enter $ROOT - refusing to run against an unknown board" >&2
    exit 3
}

if [ ! -x "$ROOT/bin/d2" ]; then
    echo "tira-bridge: no board entrypoint at $ROOT/bin/d2" >&2
    exit 3
fi

echo "tira-bridge: starting at $(date -Iseconds) as ${DD_TIRA_AUTHOR:-<undeclared>}"

# exec, so the supervisor watches the bridge itself rather than this wrapper.
# A wrapper left in the middle means systemd restarts the wrong process and the
# bridge's own exit is hidden behind a shell that is still alive.
exec "$ROOT/bin/d2" tira.policy.bridge
