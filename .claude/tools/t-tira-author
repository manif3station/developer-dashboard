#!/usr/bin/env perl

# Spec for .claude/tools/tira-author.
#
# Run: perl .claude/tools/t-tira-author

use strict;
use warnings;
use utf8;

use Test::More;
use Capture::Tiny qw(capture);
use Cwd qw(abs_path);
use File::Spec;

my $tool = File::Spec->catfile( abs_path('.'), '.claude', 'tools', 'tira-author' );

ok( -x $tool, 'the resolver is executable' );

# Purpose: run the resolver with a named environment and nothing inherited, the
#          way cron and the monitors will run it.
# Input:   hash of environment variables
# Output:  (stdout, stderr, exit code)
sub run_with_env {
    my (%env) = @_;
    my @assignments = map { "$_=$env{$_}" } sort keys %env;
    my ( $stdout, $stderr, $exit ) = capture {
        system( 'env', '-i', @assignments, $tool );
    };
    chomp $stdout;
    return ( $stdout, $stderr, $exit >> 8 );
}

# An explicit name always wins. This is the case that matters most, because it is
# how an actor that knows what it is - a named sweep, a named round - says so
# rather than being guessed at.
{
    my ( $out, $err, $exit ) = run_with_env( DD_TIRA_AUTHOR => 'ft99-sweep' );
    is( $out,  'ft99-sweep', 'a declared actor name is used exactly as given' );
    is( $exit, 0,            'and that is not an error' );
}

# THE FAILURE THIS FILE EXISTS FOR. DD-526 collected three comments within
# minutes, all authored 'DD Bot', about the same running gate - one of them
# asserting a file count that no log on the machine ever reached. The board
# showed nothing to separate them, so the contradiction was only findable by
# leaving the board for ps and the logs. A shared author is not a cosmetic
# problem: it makes a wrong record and a right record look identical.
#
# So the resolver must NEVER answer with the shared name. Whatever it cannot
# work out, it must not resolve to the one value that hides the difference.
{
    for my $env (
        { HOME => $ENV{HOME}, PATH => '/usr/bin:/bin' },
        { HOME => $ENV{HOME}, PATH => '/usr/bin:/bin', DD_TIRA_AUTHOR => '' },
      )
    {
        my ( $out, $err, $exit ) = run_with_env( %{$env} );
        isnt( $out, 'DD Bot', 'the shared author is never what this resolves to' );
        isnt( $out, '',       'and it always answers with something usable' );
        is( $exit, 0, 'and reports success' );
    }
}

# Cron, the monitors and the collectors are started by the system and carry no
# session identifier. Nothing declared and no session means automation.
{
    my ( $out, $err, $exit ) = run_with_env( HOME => $ENV{HOME}, PATH => '/usr/bin:/bin' );
    is( $out, 'dd-hourly',
        'a process with no declared name and no session resolves to the automation identity' );
}

# THE BUG THE FIRST VERSION OF THIS TOOL HAD, and it survived about one minute of
# use. The resolver tested `-t STDIN`, on the reasoning that a person at a
# keyboard has a terminal and cron does not. An agent tool-shell has no terminal
# either, so the very session driving this project was told it was the hourly
# automation - the exact collision this card exists to stop, reintroduced by the
# fix for it.
#
# A session carries a session identifier; cron does not. That is a real
# difference between the two, where the terminal was not.
{
    for my $marker (qw(CLAUDE_CODE_SESSION_ID CLAUDE_SESSION_ID)) {
        my ( $out, $err, $exit ) = run_with_env(
            HOME    => $ENV{HOME},
            PATH    => '/usr/bin:/bin',
            $marker => 'abc-123',
        );
        is( $out, 'dd-session',
            "a session identified by $marker is not mistaken for the automation, terminal or not" );
    }

    # An empty marker is not a session. A variable that exists but says nothing is
    # the shape of every instrument failure recorded on this project.
    my ( $out, $err, $exit ) = run_with_env(
        HOME                   => $ENV{HOME},
        PATH                   => '/usr/bin:/bin',
        CLAUDE_CODE_SESSION_ID => '',
    );
    is( $out, 'dd-hourly', 'an empty session identifier is not treated as a session' );
}

# The name has to be usable as an author on the board, which means no whitespace
# or shell-significant characters to be quoted wrongly at some later call site.
{
    my ( $out, $err, $exit ) = run_with_env( HOME => $ENV{HOME}, PATH => '/usr/bin:/bin' );
    like( $out, qr/\A[A-Za-z0-9_-]+\z/,
        'the resolved name needs no quoting, so a caller cannot mangle it' );
}

# A declared name is trusted, but not blindly: a name that would need quoting is
# refused loudly rather than passed on to become a confusing author on a card.
{
    my ( $out, $err, $exit ) = run_with_env( DD_TIRA_AUTHOR => 'two words' );
    isnt( $exit, 0, 'a declared name that needs quoting is refused' );
    like( $err, qr/DD_TIRA_AUTHOR/, 'and the refusal names the variable at fault' );
    is( $out, '', 'and nothing is printed that a caller could use by accident' );
}

done_testing;
