#!/usr/bin/env perl

# policy-sweep — keep the Tira policy set equal to what this project decided.
#
# TWO DRIFTS, BOTH SILENT BY CONSTRUCTION
#   A declared policy that disappears leaves no evidence. Police simply stops
#   mentioning that rule while continuing to speak about everything else, which
#   reads as compliance rather than as a missing check.
#
#   And a rule Tira gains in a future release is never considered here at all.
#   Nobody is told about a capability they never had. The policy subsystem itself
#   arrived one day and the bug-reporting command the day after; the catalogue
#   will grow again, and this project's set would quietly stop being complete
#   against a standard it would have adopted had it known.
#
# WHAT IT WILL AND WILL NOT DO
#   It RESTORES a rule this project already decided to have, because that
#   decision is recorded in the manifest and re-declaring it changes nothing
#   anybody has to think about.
#
#   It REFUSES to declare a rule nobody has judged. That is not caution for its
#   own sake: a rule declared by a robot polices work nobody agreed to police,
#   and does so wearing the appearance of a decision. New rules are reported and
#   left for a person.
#
# Exit codes follow ft99-sweep, because "the set is correct" and "I could not
# check the set" must never look alike:
#     0  the set matches what was decided
#     1  drift was found (restored, re-declined, retired) or a NEW rule needs judging
#     2  usage error
#     3  could not look — catalogue or board unreadable, deliberately NOT zero
#     4  could not write its own log — also NOT zero

use strict;
use warnings;
use feature 'say';

use FindBin;
use File::Path qw(make_path);
use File::Spec;
use JSON::XS;
use Capture::Tiny qw(capture);

use constant {
    EXIT_MATCHED  => 0,
    EXIT_DRIFT    => 1,
    EXIT_USAGE    => 2,
    EXIT_UNUSABLE => 3,
    EXIT_NO_LOG   => 4,
};

our $LOG_HANDLE;

# Purpose: the checkout this script lives in, from its own location rather than
#          the caller's working directory — cron runs from $HOME.
# Input:   none
# Output:  absolute path to the project root
sub project_root {
    # DD_POLICY_SWEEP_ROOT is the testability seam, and it is needed rather than
    # convenient: Tira discovers its project by walking up from the WORKING
    # DIRECTORY, so a copy of this script running inside a ticket sandbox cannot
    # resolve the board at all - it exits 3 saying so, correctly, which makes it
    # untestable from the sandbox it is developed in without this override.
    return $ENV{DD_POLICY_SWEEP_ROOT} if defined $ENV{DD_POLICY_SWEEP_ROOT} && -d $ENV{DD_POLICY_SWEEP_ROOT};
    return File::Spec->rel2abs( File::Spec->catdir( $FindBin::Bin, File::Spec->updir, File::Spec->updir ) );
}

# Purpose: extend PERL5LIB in place, because cron reads no shell profile and d2
#          loads the product's dependencies from the operator's local tree. The
#          FT99 sweep exited 3 on every scheduled run for exactly this reason
#          while passing by hand.
# Input:   none
# Output:  none
sub ensure_library_path {
    my $home = $ENV{HOME} or return;
    my $local_lib = File::Spec->catdir( $home, 'perl5', 'lib', 'perl5' );
    return if !-d $local_lib;
    my $current = $ENV{PERL5LIB};
    return if defined $current && grep { $_ eq $local_lib } split /:/, $current;
    $ENV{PERL5LIB} = defined $current && length $current ? "$local_lib:$current" : $local_lib;
    return;
}

# Purpose: run one d2 subcommand and return parsed JSON.
# Input:   $d2 path, list of arguments
# Output:  the decoded structure; dies with a readable reason on any failure, so
#          an unreadable board is never mistaken for an empty one
sub d2_json {
    my ( $d2, @args ) = @_;
    my ( $stdout, $stderr, $exit ) = capture { system( $d2, @args, '-o', 'json' ); };
    die "'@args' failed (exit $exit): " . ( $stderr || 'no diagnostic' ) . "\n" if $exit != 0;
    my $parsed = eval { decode_json($stdout) };
    die "'@args' did not return usable JSON: $@\n" if !defined $parsed;
    return $parsed;
}

# Purpose: every rule name Tira currently ships, read from its own documentation
#          rather than from a list kept here — a list kept here could not notice
#          the catalogue growing, which is half the point of this job.
# Input:   $d2 path
# Output:  arrayref of rule names
sub catalogue_rules {
    my ($d2) = @_;
    my ( $stdout, $stderr, $exit ) = capture { system( $d2, 'tira.policies' ); };
    die "reading the policy catalogue failed (exit $exit): " . ( $stderr || 'no diagnostic' ) . "\n" if $exit != 0;
    return parse_catalogue($stdout);
}

# Purpose: the rule names in the catalogue text, and nothing else.
# Input:   the tira.policies document as one string
# Output:  arrayref of rule names
#
# ONLY the rules table. The actions table uses the identical row shape, so a
# document-wide match returned bridge-reminder, print-reminder and log-only as
# rules - three things that can never be declared, reported as needing a decision,
# every hour, for ever. A parser that is nearly right about its subject is how a
# checker becomes noise, and this one was wrong on its first real run.
sub parse_catalogue {
    my ($text) = @_;
    my ($section) = ( $text // '' ) =~ /^##\s+The rules\s*$(.*?)^##\s+/ms;
    die "the policy catalogue has no 'The rules' section, so its format has changed\n" if !defined $section;

    my %seen;
    my @rules = grep { !$seen{$_}++ } ( $section =~ /^\|\s*`([a-z][a-z0-9-]+)`\s*\|/mg );
    die "the policy catalogue listed no rules at all, which cannot be right\n" if !@rules;
    return \@rules;
}

# Purpose: decide, for every rule Tira ships, what this project should do.
# Input:   $catalogue arrayref, $live arrayref of declared policies,
#          $manifest hashref, $declined arrayref of rule names currently declined
# Output:  hashref with ok/restore/redecline/new/retired lists and a total
#
# Kept pure and free of d2 so the spec can exercise the DECISIONS rather than the
# plumbing, and so a wrong decision fails a test rather than editing a board.
sub reconcile {
    my ( $catalogue, $live, $manifest, $declined ) = @_;
    $declined ||= [];

    my %is_live     = map { $_->{rule} => 1 } @{ $live || [] };
    my %is_declined = map { $_ => 1 } @{$declined};
    my %in_catalogue = map { $_ => 1 } @{$catalogue};

    my %want_declared;
    for my $entry ( @{ $manifest->{declared} || [] } ) {
        push @{ $want_declared{ $entry->{rule} } }, $entry;
    }
    my %want_declined = map { $_->{rule} => $_ } @{ $manifest->{declined} || [] };

    my %plan = ( ok => [], restore => [], redecline => [], new => [], retired => [], conflicts => [], total => 0 );

    for my $rule ( @{$catalogue} ) {
        $plan{total}++;

        # A decline on the board outranks the manifest. It is a decision with a
        # reason attached, made later than this file, and restoring over it makes
        # the decision look as though it never happened - which this sweep did on
        # 2026-08-14, putting back a rule declined an hour earlier and sending it
        # back to urgent. The disagreement is reported so the manifest can be
        # corrected deliberately rather than silently overridden either way.
        if ( $is_declined{$rule} && $want_declared{$rule} ) {
            push @{ $plan{ok} }, $rule;
            push @{ $plan{conflicts} },
              "$rule is declined on the board but the manifest lists it as declared - the decline stands; update the manifest";
            next;
        }

        if ( $want_declared{$rule} ) {
            # Every entry for this rule is wanted; a rule may legitimately be
            # declared several times, once per column it is scoped to.
            my $wanted = scalar @{ $want_declared{$rule} };
            my $have   = scalar grep { $_->{rule} eq $rule } @{ $live || [] };
            if ( $have >= $wanted ) {
                push @{ $plan{ok} }, $rule;
            }
            else {
                push @{ $plan{restore} }, @{ $want_declared{$rule} };
            }
            next;
        }

        if ( $want_declined{$rule} ) {
            push @{ $is_declined{$rule} ? $plan{ok} : $plan{redecline} },
              $is_declined{$rule} ? $rule : $want_declined{$rule};
            next;
        }

        # Judged by nobody. Reported, never declared.
        push @{ $plan{new} }, { rule => $rule };
    }

    # A rule the manifest wants that Tira no longer ships. Restoring it would
    # fail every hour and teach the reader to ignore this log, so it is reported
    # for the manifest to be corrected by hand.
    for my $rule ( sort keys %want_declared, keys %want_declined ) {
        push @{ $plan{retired} }, $rule if !$in_catalogue{$rule};
    }

    return \%plan;
}

# Purpose: turn one manifest entry back into a policy.add argument list.
# Input:   entry hashref
# Output:  list of arguments
sub declare_args {
    my ($entry) = @_;
    my %flag = (
        action        => '--action',
        age           => '--age',
        column        => '--column',
        enter         => '--enter',
        before_column => '--before-column',
        max           => '--max',
        pattern       => '--pattern',
        sandbox       => '--sandbox',
        require       => '--require',
        require_link  => '--require-link',
        on_column     => '--on-column',
        message       => '--message',
        type          => '--type',
    );
    my @args = ( 'tira.policy.add', '--rule', $entry->{rule} );
    for my $key ( sort keys %flag ) {
        push @args, $flag{$key}, $entry->{$key} if defined $entry->{$key} && $entry->{$key} ne '';
    }
    return @args;
}

# Purpose: emit to the terminal AND to this job's own log, so a scheduled run
#          leaves a record without depending on a shell redirect that cannot
#          report its own failure.
# Input:   the line
# Output:  none
sub emit {
    my ($line) = @_;
    say $line;
    say {$LOG_HANDLE} $line if $LOG_HANDLE;
    return;
}

# Purpose: open the log, creating its directory, and say so loudly if it cannot.
# Input:   none
# Output:  the path, or undef after a diagnostic
sub open_log {
    my $path = $ENV{DD_POLICY_SWEEP_LOG} || File::Spec->catfile( project_root(), 'logs', 'policy-sweep.log' );
    my ( $volume, $dir ) = File::Spec->splitpath($path);
    my $log_dir = File::Spec->catpath( $volume, $dir, '' );
    if ( length $log_dir && !-d $log_dir ) {
        make_path($log_dir);
        if ( !-d $log_dir ) {
            say STDERR "policy-sweep: cannot create the log directory $log_dir: $!";
            return;
        }
    }
    if ( !open $LOG_HANDLE, '>>', $path ) {
        say STDERR "policy-sweep: cannot write the log $path: $!";
        undef $LOG_HANDLE;
        return;
    }
    my $previous = select $LOG_HANDLE;
    $| = 1;
    select $previous;
    return $path;
}

# Purpose: reconcile the live policy set against the manifest and act.
# Input:   @ARGV — none accepted
# Output:  one of the EXIT_* codes
sub main {
    if (@ARGV) {
        say STDERR 'policy-sweep: takes no arguments';
        return EXIT_USAGE;
    }

    ensure_library_path();
    if ( !defined open_log() ) {
        say STDERR 'policy-sweep: refusing to run without a log - a check nobody can read is not a check';
        return EXIT_NO_LOG;
    }

    my $root = project_root();
    chdir $root or do {
        emit("policy-sweep: UNUSABLE - cannot enter the project root $root: $!");
        return EXIT_UNUSABLE;
    };

    my $d2 = File::Spec->catfile( $root, 'bin', 'd2' );
    if ( !-x $d2 ) {
        emit("policy-sweep: UNUSABLE - cannot find an executable d2 at $d2");
        return EXIT_UNUSABLE;
    }

    # DD_POLICY_SWEEP_MANIFEST separates WHERE THE BOARD IS from WHERE THE
    # DECISIONS ARE. They are normally the same checkout, but a copy under test
    # must read the manifest it is changing while talking to the real board,
    # which only resolves from the main checkout.
    my $manifest_path = $ENV{DD_POLICY_SWEEP_MANIFEST}
      || File::Spec->catfile( $root, '.claude', 'policy-manifest.json' );
    my $manifest = eval {
        open my $fh, '<', $manifest_path or die "cannot read $manifest_path: $!\n";
        local $/;
        decode_json(<$fh>);
    };
    if ( !$manifest ) {
        my $error = $@ || 'unknown failure';
        chomp $error;
        emit("policy-sweep: UNUSABLE - $error");
        return EXIT_UNUSABLE;
    }

    my ( $catalogue, $live, $declined ) = eval {
        (
            catalogue_rules($d2),
            d2_json( $d2, 'tira.policy.list' ),
            [ map { ref $_ ? $_->{rule} : $_ } @{ d2_json( $d2, 'tira.policy.declined' ) } ],
        );
    };
    if ( !$catalogue ) {
        my $error = $@ || 'unknown failure';
        chomp $error;
        emit("policy-sweep: UNUSABLE - $error");
        return EXIT_UNUSABLE;
    }

    my $plan = reconcile( $catalogue, $live, $manifest, $declined );

    my @acted;
    for my $entry ( @{ $plan->{restore} } ) {
        my ( undef, $stderr, $exit ) = capture { system( $d2, declare_args($entry) ); };
        push @acted, $exit == 0
          ? "restored $entry->{rule}"
          : "FAILED to restore $entry->{rule}: " . ( $stderr || 'no diagnostic' );
    }
    for my $entry ( @{ $plan->{redecline} } ) {
        my ( undef, $stderr, $exit ) = capture {
            system( $d2, 'tira.policy.decline', '--rule', $entry->{rule}, '--reason', $entry->{reason} );
        };
        push @acted, $exit == 0
          ? "re-declined $entry->{rule}"
          : "FAILED to re-decline $entry->{rule}: " . ( $stderr || 'no diagnostic' );
    }

    emit( sprintf 'policy-sweep: accounted for %d of %d rules Tira ships (%d as decided, %d restored, %d re-declined, %d new)',
        $plan->{total}, scalar @{$catalogue},
        scalar @{ $plan->{ok} }, scalar @{ $plan->{restore} }, scalar @{ $plan->{redecline} }, scalar @{ $plan->{new} } );

    emit("policy-sweep: $_") for @acted;
    emit("policy-sweep: CONFLICT - $_") for @{ $plan->{conflicts} || [] };
    emit("policy-sweep: RETIRED - the manifest wants '$_' but Tira no longer ships it; correct the manifest by hand")
      for @{ $plan->{retired} };

    for my $entry ( @{ $plan->{new} } ) {
        emit( "policy-sweep: NEEDS A DECISION - Tira ships '$entry->{rule}' and nobody here has judged it. "
              . "Read 'd2 tira.policies', then either declare it or decline it with a reason - "
              . 'it is deliberately NOT declared automatically, because a rule nobody agreed to polices work nobody agreed to police.' );
    }

    return EXIT_MATCHED
      if !@acted && !@{ $plan->{new} } && !@{ $plan->{retired} } && !@{ $plan->{conflicts} || [] };
    return EXIT_DRIFT;
}

exit main() if !caller;

1;

__END__

=head1 NAME

policy-sweep - keep the Tira policy set equal to what this project decided

=head1 PURPOSE

Reconcile, every hour, three things: the rules Tira currently ships, the rules
declared on this project's board, and the manifest of what this project decided.
Restore what has gone missing, and report what nobody has judged.

=head1 WHY IT EXISTS

Both ways the policy set can drift are silent. A declared policy that disappears
leaves no evidence at all - police simply stops mentioning that rule while
continuing to speak about everything else, which reads as compliance. And a rule
added in a future Tira release is never considered here, because nobody is told
about a capability they never had; the policy subsystem itself arrived one day
and the bug-reporting command the day after.

=head1 WHEN TO USE

Hourly, from cron. It is safe to run by hand at any time.

=head1 HOW TO USE

    .claude/tools/policy-sweep

Exit codes distinguish a correct set from an unexamined one: 0 matched, 1 drift
found or a new rule needs judging, 3 could not look, 4 could not write its log.

=head1 WHAT USES IT

The hourly cron entry. Nothing in the shipped product depends on it: it is
operator tooling under C<.claude/>, excluded from the release tarball.

=head1 EXAMPLES

The refusal is the important part:

    policy-sweep: NEEDS A DECISION - Tira ships 'card-metrics' and nobody here
    has judged it. Read 'd2 tira.policies', then either declare it or decline it
    with a reason - it is deliberately NOT declared automatically.

=cut
