#!/usr/bin/env perl

# police-outstanding - are there violations nobody has cleared?
#
# WHY THIS EXISTS (DD-570)
#   The owner asked for a half-hourly `d2 tira.police.outstanding`, and the first
#   run found 154 violations that had been accumulating since 2026-08-15, seen
#   fifteen times each. None had reached the bridge, because 153 of them carry
#   action "log-only" - and I had read that as "not actionable". It is not:
#   log-only describes how a violation is DELIVERED, not whether it matters.
#   Follow-up continues until every one is cleared.
#
#   The raw command is the wrong shape for a recurring job. It prints 1387 lines
#   of records and always exits 0, so a run with 154 outstanding and a run with
#   none are indistinguishable to anything reading a status - which is precisely
#   the property that let them pile up unseen while a log grew in a directory
#   nobody opened.
#
#   So this is a GATE, not a report. It stays red until the board is clear, and
#   what it prints is a work list rather than a data dump.
#
# Exit codes, kept distinct because "clear" and "I could not look" must never be
# the same answer - every checker on this project has been bitten by that:
#     0  nothing outstanding
#     1  violations outstanding; they are listed, by rule, with their refs
#     2  usage error
#     3  could not look - the board would not answer

use strict;
use warnings;
use feature 'say';

use FindBin;
use File::Basename qw(dirname);
use File::Spec;
use JSON::XS;
use Capture::Tiny qw(capture);

use constant {
    EXIT_CLEAR    => 0,
    EXIT_OUTSTAND => 1,
    EXIT_USAGE    => 2,
    EXIT_UNUSABLE => 3,
};

# Purpose: the MAIN checkout. Every card is worked in its own worktree, and the
#          project selector naming this board lives only in the main checkout
#          (DD-545), so a run from a sandbox must resolve back to it.
#
# DD_POLICE_ROOT overrides it outright (DD-577), which is what lets the spec
# exercise the REAL d2 invocation against a directory Tira genuinely cannot
# resolve a project from, rather than only the fixture path.
sub project_root {
    return $ENV{DD_POLICE_ROOT} if defined $ENV{DD_POLICE_ROOT};    # uncoverable branch false
    my $here = File::Spec->rel2abs( File::Spec->catdir( $FindBin::Bin, File::Spec->updir, File::Spec->updir ) );
    my ( $common, undef, $exit ) = capture {
        system( 'git', '-C', $here, 'rev-parse', '--path-format=absolute', '--git-common-dir' );
    };
    return $here if $exit != 0;
    chomp $common;
    return $here if $common eq '';
    my $root = dirname($common);
    return -d $root ? $root : $here;
}

# Purpose: make this work in the environment a SCHEDULE actually runs it in.
#          PERL5LIB is exported only by interactive shell init, so d2 cannot load
#          the product's dependencies from a cron shell. Caught by running this
#          under `env -i` before it went live: the gate returned 3, "could not
#          read the board", which is exactly what that exit code exists to say -
#          and would have meant a half-hourly job that never once looked, while
#          its log filled with a message that reads like diligence.
# Input:   none
# Output:  none; PERL5LIB is extended in place
sub ensure_library_path {
    my $lib = File::Spec->catdir( $ENV{HOME} // '', 'perl5', 'lib', 'perl5' );
    return if !-d $lib;                                  # uncoverable branch true
    return if ( $ENV{PERL5LIB} // '' ) =~ /\Q$lib\E/;
    $ENV{PERL5LIB} = $ENV{PERL5LIB} ? "$lib:$ENV{PERL5LIB}" : $lib;
    return;
}

# Purpose: the outstanding violations, as the board reports them, AND the
#          status that decides clear/outstanding/unusable.
# Input:   none
# Output:  ($records, $status) - $records is an arrayref (possibly empty) or
#          undef when there is none to trust; $status is EXIT_CLEAR,
#          EXIT_OUTSTAND, or undef when nothing could be established.
#
# DD-577: Tira 2.40 shipped --exit-nonzero-if-any, so the LIVE path now trusts
# the native exit status as the decision rather than re-deriving clear versus
# outstanding by counting @{$records} itself - the thing this tool existed to
# supply before the upstream fix landed (DD-570/TKT-279). Probed against 2.49
# before this was written: on exit 0 or 1 the JSON body is on STDOUT exactly as
# before; on any OTHER exit (2 in every case observed, whether the cause was an
# unresolvable project or a plain usage error) STDOUT is completely EMPTY, so
# the body is never decoded for those - there is nothing there to decode, and
# decoding stderr would mean parsing a stream that mixes plain text with JSON
# on the usage-error path specifically.
#
# DD_POLICE_JSON points at a fixture instead, which is what makes the three
# outcomes testable without a board. Without an injection point a spec cannot
# control its own subject, and a check aimed at the wrong subject can only return
# the answer it hoped for - a fault already met twice on this project tonight.
# DD_POLICE_EXIT pairs with it to simulate the native exit status independently
# of the fixture's content, proving this code TRUSTS the status rather than
# merely agreeing with it by coincidence; left unset, a sensible default is
# computed from content so every case written before DD-577 still passes
# unmodified.
sub outstanding {
    my $raw;
    my $status;
    if ( my $fixture = $ENV{DD_POLICE_JSON} ) {
        return ( undef, undef ) if !-f $fixture;
        open my $fh, '<', $fixture or return ( undef, undef );
        local $/;
        $raw = <$fh>;
        $status = $ENV{DD_POLICE_EXIT};
    }
    else {
        my $root = project_root();
        my $d2   = File::Spec->catfile( $root, 'bin', 'd2' );
        return ( undef, undef ) if !-x $d2;    # uncoverable branch true
        # TIRA_HOME MUST BE STRIPPED, not merely left alone (same class of bug as
        # DD-584: an interactive shell's TIRA_HOME=tira-ddd, exported for its own
        # convenience, resolves a project ahead of CWD - so a caller pointing this
        # at a DIFFERENT project via DD_POLICE_ROOT would silently read the wrong
        # board instead, or fail to resolve at all if that selector means nothing
        # from the target directory. Invisible in normal use, because TIRA_HOME
        # happens to already name the real board - it only bites the moment
        # project_root() resolves somewhere else, which is exactly what this
        # tool's own test does to prove the live path without touching production.
        my ( $out, undef, $exit ) = capture {
            system( 'sh', '-c',
                "cd \Q$root\E && env -u TIRA_HOME \Q$d2\E tira.police.outstanding -o json --exit-nonzero-if-any 2>/dev/null"
            );
        };
        # >> 8: Capture::Tiny's third value is the raw wait status, not the exit
        # code - this exact omission was ALREADY here before DD-577 and was
        # invisible, because the pre-2.40 native command always exited 0
        # regardless of content (0 raw and 0>>8 are identically 0). Adding
        # --exit-nonzero-if-any is what exposed it: a real "outstanding" exit of
        # 1 arrives as raw 256, which is neither EXIT_CLEAR nor EXIT_OUTSTAND
        # unshifted, so every outstanding board was silently reported UNUSABLE
        # until this line existed. Found only because the sandbox-based live
        # test (DD-577) exercises a real, resolvable board with a real
        # violation - every fixture-based case and the /tmp unresolvable case
        # happened to need no shift (0 stays 0; a genuine spawn failure from
        # system() itself is -1, unaffected by >>8) and so could not catch it.
        $status = $exit >> 8;
        return ( undef, $status ) if $status != EXIT_CLEAR && $status != EXIT_OUTSTAND;
        $raw = $out;
    }
    return ( undef, $status ) if !defined $raw || $raw !~ /\S/;
    my $parsed = eval { decode_json($raw) };
    return ( undef, $status ) if !$parsed;
    my $records =
        ref $parsed eq 'ARRAY'                        ? $parsed
      : ref $parsed->{outstanding} eq 'ARRAY'          ? $parsed->{outstanding}    # uncoverable branch false
      :                                                  undef;
    return ( undef, $status ) if !defined $records;

    # Fixture default, computed from the DECODED array's emptiness rather than
    # the raw text's - "[]" is non-empty TEXT but an empty ARRAY, and checking
    # the text would have called every clear-board fixture "outstanding".
    # Unset only in fixture mode; the live path always supplies a real status.
    $status = @{$records} ? EXIT_OUTSTAND : EXIT_CLEAR if !defined $status;    # uncoverable branch false

    return ( $records, $status );
}

# Purpose: group the violations into the shortest thing a reader can act on.
# Input:   arrayref of violation records
# Output:  hashref of rule => arrayref of refs
sub by_rule {
    my ($records) = @_;
    my %rules;
    for my $record ( @{$records} ) {
        my $rule = $record->{rule} // '(unnamed rule)';
        my $ref  = $record->{ref}  // '(no ref)';
        push @{ $rules{$rule} }, $ref;
    }
    for my $rule ( keys %rules ) {
        my %seen;
        $rules{$rule} = [ grep { !$seen{$_}++ } @{ $rules{$rule} } ];
    }
    return \%rules;
}

sub main {
    return EXIT_USAGE if @ARGV;
    ensure_library_path();

    my ( $records, $status ) = outstanding();

    # DD-577: the DECISION is $status - trusted from the native tool's own exit
    # code on the live path - never re-derived from whether $records is empty.
    # Native's exit 2 doubles as BOTH "could not resolve the project" and "usage
    # error" (verified identical by probing both directly); either collapses
    # onto EXIT_UNUSABLE here, which is this tool's own long-standing meaning
    # for exit 3, so no existing caller's contract changes. A status claiming
    # OUTSTAND with no records to show (decode genuinely failed) is treated the
    # same way, because a work list with nothing to list is not a real answer.
    if ( !defined $status
        || ( $status != EXIT_CLEAR && $status != EXIT_OUTSTAND )
        || ( $status == EXIT_OUTSTAND && !defined $records ) )
    {
        say STDERR 'police-outstanding: UNUSABLE - could not read the board. This is NOT a clear board: '
          . 'a board that will not answer and a board with nothing to report look identical from here.';
        return EXIT_UNUSABLE;
    }

    if ( $status == EXIT_CLEAR ) {
        say 'police-outstanding: CLEAR - no outstanding violations on the board.';
        return EXIT_CLEAR;
    }

    my $rules = by_rule($records);
    say STDERR sprintf 'police-outstanding: %d OUTSTANDING violation(s) across %d rule(s). Every one of these '
      . 'needs following up until it is cleared - "log-only" is how it is delivered, not whether it matters.',
      scalar @{$records}, scalar keys %{$rules};
    for my $rule ( sort { @{ $rules->{$b} } <=> @{ $rules->{$a} } || $a cmp $b } keys %{$rules} ) {
        my @refs = @{ $rules->{$rule} };
        my $show = join ' ', @refs[ 0 .. ( @refs > 12 ? 11 : $#refs ) ];
        $show .= sprintf ' ...and %d more', @refs - 12 if @refs > 12;
        say STDERR sprintf '  %4d  %-24s %s', scalar @refs, $rule, $show;
    }
    return EXIT_OUTSTAND;
}

exit main() if !caller;
1;

__END__

=head1 NAME

police-outstanding - the half-hourly gate that keeps outstanding violations
visible until they are cleared

=head1 PURPOSE

Report every violation the board still considers outstanding, grouped by rule,
and fail while any remain.

=head1 WHY IT EXISTS

The owner asked for a recurring C<d2 tira.police.outstanding>, and the first run
found 154 violations dating back two days, seen fifteen times each and never
acted on. None had reached the bridge, because almost all of them carry the
action C<log-only> - which describes how a violation is delivered, not whether it
matters.

The raw command is the wrong shape for a recurring job: it prints well over a
thousand lines and always exits zero, so a board with 154 outstanding violations
and a clear one produce the same status. This makes the recurring job an action
plan instead: short enough to read, and red until the work is done.

=head1 WHEN TO USE

Every thirty minutes from cron, and by hand after clearing anything.

=head1 HOW TO USE

    .claude/tools/police-outstanding

=head1 EXAMPLES

    $ .claude/tools/police-outstanding
    police-outstanding: CLEAR - no outstanding violations on the board.

=cut
