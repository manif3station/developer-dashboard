#!/usr/bin/env perl

# Spec for .claude/tools/ticket-worktree.
#
# Run: perl .claude/tools/t-ticket-worktree

use strict;
use warnings;
use utf8;

use Test::More;
use FindBin;
use File::Spec;

my $TOOL = File::Spec->catfile( $FindBin::Bin, 'ticket-worktree' );

# Requiring rather than running: the script ends `exit main() if !caller`, so this
# exercises its naming decisions without touching git or creating a worktree.
require $TOOL;

ok( -x $TOOL, 'the tool is executable' );

# WHY THIS FILE EXISTS (DD-560)
#   The branch and the directory used to share one name, lower-cased, on the
#   reasoning that neither could then drift from the other. They answer to
#   different readers: the path is for the filesystem, the branch is what the BOARD
#   matches against. card-sandbox-missing looks for a branch named for the card and
#   reported, every day it was declared, "missing a branch named DD-559 - dd-559
#   differs from it only in case". The rule was right; the convention in CLAUDE.md
#   had never been followed; and the finding was invisible because a custom policy
#   message had replaced the default that carried it.

# The branch is the card's reference EXACTLY. This is the assertion that matters:
# it is what the board looks for.
{
    is( main::branch_for('DD-560'), 'DD-560', 'the branch is the reference exactly' );
    is( main::branch_for('dd-560'), 'DD-560', 'a lower-cased reference is canonicalised, not preserved' );
    is( main::branch_for('DDE-12'), 'DDE-12', 'a longer prefix survives' );
    is( main::branch_for('nonsense'), undef, 'a non-reference yields nothing rather than a bad branch name' );
    is( main::branch_for(undef), undef, 'and so does nothing at all' );
}

# The directory stays lower-cased. Every card that has recorded a sandbox recorded
# THIS path, so changing it would invalidate the sandbox field on all of them.
{
    is( main::slug_for('DD-560'), 'dd-560', 'the directory is lower-cased' );
    is( main::slug_for('dd-560'), 'dd-560', 'from either input' );
    is( main::slug_for('nonsense'), undef, 'and a non-reference still yields nothing' );
}

# THE PROPERTY THIS FILE EXISTS TO DEFEND. A later tidy-up that notices "these two
# functions look the same" and merges them would silently reintroduce the exact
# defect that took a day to find - so the difference is asserted, not implied.
{
    isnt( main::branch_for('DD-560'), main::slug_for('DD-560'),
        'the branch and the directory are deliberately DIFFERENT names, and must stay so' );
    is( uc( main::slug_for('DD-560') ), main::branch_for('DD-560'),
        'they differ only in case, so one can always be derived from the other' );
}

# A sandbox cut before this change has a lower-cased branch, and resuming work must
# still find it. Asserted against the source because exercising it needs real git
# state, and a resume that refuses is worse than the naming bug it replaced.
{
    my $source = do { open my $fh, '<', $TOOL or die $!; local $/; <$fh> };
    like( $source, qr/refs\/heads\/\$branch/, 'the new branch name is looked for' );
    like( $source, qr/refs\/heads\/\$slug/,   'and the legacy lower-cased one is looked for too' );
    like( $source, qr/has_legacy/,            'so an existing sandbox is resumed rather than refused' );
}

done_testing;
