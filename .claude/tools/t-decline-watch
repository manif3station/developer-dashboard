#!/usr/bin/env perl

# t-decline-watch - the spec for the declined-policy watcher.
#
# WHY THIS FILE EXISTS (DD-565)
#   decline-watch exists because a declined policy had no watcher and that gap
#   cost two missed re-declares in one hour. A watcher introduced to close a gap
#   is worth exactly as much as the evidence that it works, so every property
#   here is asserted in BOTH directions - a case it must report and a case it
#   must not. A rule that only ever fires and a rule that never fires both look
#   like working code, and neither is a check.
#
#   The trigger checks are injected rather than executed. A spec that reached the
#   real board would be testing tonight's board rather than the checker, and
#   would go green or red for reasons that have nothing to do with this code.
#
# RUNNING IT
#   PERL5LIB="$HOME/perl5/lib/perl5" perl .claude/tools/t-decline-watch

use strict;
use warnings;

use Test::More;
use FindBin;
use File::Spec;

my $TOOL = File::Spec->catfile( $FindBin::Bin, 'decline-watch' );

require $TOOL;

ok( -x $TOOL, 'the checker is executable' );

# Purpose: one decline record in the shape the board returns.
sub decline {
    my ( $rule, $reason ) = @_;
    return { rule => $rule, reason => $reason, declined_at => '2026-08-16T00:00:00+0100' };
}

# --------------------------------------------------------------------------
# AC-1: a trigger that has fired is the whole point.
# --------------------------------------------------------------------------
{
    local %main::TRIGGERS = ( 'has-fired' => sub { return 1 } );
    my $why = main::judge( decline( 'some-rule', 'Declined for now. RE-DECLARE TRIGGER: has-fired' ) );
    like( $why, qr/FIRED/, 'a decline whose condition has fired is reported' );
    like( $why, qr/some-rule/, 'and the finding names the rule, so it can be acted on without a lookup' );
}

# --------------------------------------------------------------------------
# AC-2: it must be able to come back clean, or nobody will read it.
# --------------------------------------------------------------------------
{
    local %main::TRIGGERS = ( 'not-yet' => sub { return 0 } );
    is( main::judge( decline( 'some-rule', 'Declined. RE-DECLARE TRIGGER: not-yet' ) ),
        undef, 'a decline whose condition has NOT fired is left alone' );
}

# --------------------------------------------------------------------------
# AC-3: unclassified and unevaluable are their own answers, never "fine".
#
# This is the state that hid both failures this tool was written for: a decline
# nobody had revisited looks exactly like one that is still right.
# --------------------------------------------------------------------------
{
    my $why = main::judge( decline( 'some-rule', 'Declined because it was noisy. No trigger here.' ) );
    like( $why, qr/no re-declare trigger/, 'a decline that declares no trigger is reported' );
    like( $why, qr/RE-DECLARE TRIGGER: none/, 'and the finding says exactly what to write to settle it' );
}

{
    local %main::TRIGGERS = ();
    my $why = main::judge( decline( 'some-rule', 'RE-DECLARE TRIGGER: nobody-implemented-this' ) );
    like( $why, qr/UNVERIFIED/, 'a trigger the checker cannot evaluate leaves the decline UNVERIFIED' );
    unlike( $why, qr/FIRED/, 'and is not confused with one that has fired' );
}

{
    local %main::TRIGGERS = ( 'cannot-look' => sub { return undef } );
    my $why = main::judge( decline( 'some-rule', 'RE-DECLARE TRIGGER: cannot-look' ) );
    like( $why, qr/UNVERIFIED/, 'a trigger that could not be evaluated is UNVERIFIED, not satisfied' );
}

# --------------------------------------------------------------------------
# A deliberately permanent decline is quiet - but it has to SAY so.
#
# Without this, the checker fires for ever on decisions that are settled, which
# is the failure it was explicitly designed against: a guardrail that is always
# red still looks like it is working while teaching its reader to skim.
# --------------------------------------------------------------------------
{
    is( main::judge( decline( 'card-unlinked', 'This will never apply here. RE-DECLARE TRIGGER: none' ) ),
        undef, 'a decline declared permanent is quiet' );
    is( main::judge( decline( 'card-unlinked', 'RE-DECLARE TRIGGER: NONE' ) ),
        undef, 'and the declaration is not case-sensitive' );
}

# --------------------------------------------------------------------------
# The trigger must be DECLARED, not inferred from prose. Every decline on this
# board narrates its own history and mentions ticket numbers; inferring triggers
# from that would report all of them for ever.
# --------------------------------------------------------------------------
{
    my $chatty = decline( 'some-rule',
        'Declined 2026-08-14 after TKT-239 and TKT-269 were discussed at length, see also 00dddbc.' );
    my $why = main::judge($chatty);
    like( $why, qr/no re-declare trigger/,
        'a reason that merely mentions ticket numbers is NOT read as a trigger' );
}

# --------------------------------------------------------------------------
# AC-5: every decline is accounted for.
# --------------------------------------------------------------------------
{
    local %main::TRIGGERS = ( 'fired' => sub { return 1 }, 'quiet' => sub { return 0 } );
    my @declines = (
        decline( 'a', 'RE-DECLARE TRIGGER: fired' ),
        decline( 'b', 'RE-DECLARE TRIGGER: quiet' ),
        decline( 'c', 'RE-DECLARE TRIGGER: none' ),
        decline( 'd', 'nothing declared' ),
    );
    my @findings = grep { defined } map { main::judge($_) } @declines;
    is( scalar @findings, 2, 'exactly the fired one and the unclassified one are reported' );
}

# "Could not look" must never be reportable as clean - the mistake this project
# has made repeatedly with empty credentials and unreadable boards.
{
    my $source = do { open my $fh, '<', $TOOL or die $!; local $/; <$fh> };
    like( $source, qr/EXIT_UNUSABLE\s*=>\s*3/, 'there is a distinct exit code for being unable to look' );
    like( $source, qr/accounted for/,          'and it states N of N rather than only its findings' );
}

done_testing;
