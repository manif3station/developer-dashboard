#!/usr/bin/env perl

# Spec for .claude/tools/board - board access that works from a ticket worktree.
#
# Run: PERL5LIB="$HOME/perl5/lib/perl5" perl .claude/tools/t-board

use strict;
use warnings;
use utf8;

use Test::More;
use Capture::Tiny qw(capture);
use Cwd qw(abs_path getcwd);
use File::Spec;
use FindBin;
use File::Temp ();

my $TOOL = File::Spec->catfile( $FindBin::Bin, 'board' );
my $ROOT = abs_path( File::Spec->catdir( $FindBin::Bin, File::Spec->updir, File::Spec->updir ) );

ok( -x $TOOL, 'the board wrapper is executable' );

# Purpose: run the wrapper from a named directory, so a test can say "from a
#          worktree" rather than depending on where prove happened to start.
# Input:   $dir to run in, then the arguments
# Output:  (stdout, stderr, exit code)
sub run_from {
    my ( $dir, @args ) = @_;
    my $back = getcwd();
    chdir $dir or die "Unable to chdir to $dir: $!";
    my ( $stdout, $stderr, $exit ) = capture { system( $TOOL, @args ) };
    chdir $back or die "Unable to return to $back: $!";
    return ( $stdout, $stderr, $exit >> 8 );
}

# THE FAILURE THIS FILE EXISTS FOR (DD-545). Every card is worked in its own git
# worktree, and the board must be kept current AS the work happens. Both are
# standing rules and they could not both be obeyed: a worktree is cut from
# origin/master, which carries no .developer-dashboard layer, so the project
# selector that maps this project to its board exists only in the main checkout.
# Every d2 tira.* command run from a sandbox died with
# "Cannot resolve project selector 'tira-ddd'".
#
# The consequence was not a wrong board - it was pressure to BATCH board updates
# until the agent returned to the main checkout, and batched updates are the
# exact failure the always-current rule exists to prevent.
{
    my $worktree = $ENV{DD_TEST_WORKTREE};
  SKIP: {
        skip 'no ticket worktree available to test from', 3
          if !defined $worktree || !-d $worktree;

        my ( $out, $err, $exit ) = run_from( $worktree, 'tira.ticket.list', '--refs-only' );
        is( $exit, 0, 'a board command run from a ticket worktree succeeds' );
        unlike( $err, qr/Cannot resolve project selector/,
            'and specifically does not fail to find which board this project uses' );
        like( $out, qr/DD-\d+/, 'and returns real cards rather than an empty success' );
    }
}

# The same command from the main checkout must behave identically. A wrapper that
# only works in the unusual case would just move the problem.
{
    my ( $out, $err, $exit ) = run_from( $ROOT, 'tira.ticket.list', '--refs-only' );
    is( $exit, 0, 'and from the main checkout too' );
    like( $out, qr/DD-\d+/, 'returning the same kind of answer' );
}

# Resolution must not depend on the caller's working directory at all. The
# original spec here asserted the opposite - that running from /tmp would refuse -
# and the tool proved it wrong: it resolves from its OWN location, so it works
# from anywhere. That is the stronger property and the one worth pinning, because
# the failure being fixed was caused precisely by resolving from the caller's
# directory.
{
    my ( $out, $err, $exit ) = run_from( File::Spec->tmpdir, 'tira.ticket.list', '--refs-only' );
    is( $exit, 0, 'the caller\'s directory is irrelevant - it resolves from its own location' );
    like( $out, qr/DD-\d+/, 'and still reaches the right board' );
}

# The refusal case is real, but it is a COPY of this script outside any checkout -
# not a caller standing somewhere odd. A wrapper that quietly ran some other d2,
# or silently did nothing, would send board writes somewhere nobody examines.
{
    my $dir  = File::Temp::tempdir( 'dd-board-XXXXXX', CLEANUP => 1, TMPDIR => 1 );
    my $copy = File::Spec->catfile( $dir, 'board' );

    # A copy, deliberately: the point is a script whose own location is outside
    # any checkout, which is the only way this resolution can genuinely fail.
    open my $in,  '<', $TOOL or die $!;
    open my $out, '>', $copy or die $!;
    print {$out} do { local $/; <$in> };
    close $in;
    close $out or die $!;
    chmod 0755, $copy or die $!;

    my ( $stdout, $stderr, $exit ) = capture { system( $copy, 'tira.ticket.list' ) };
    isnt( $exit >> 8, 0, 'a copy outside any checkout refuses rather than guessing' );
    like( $stderr, qr/checkout|repository|git/i, 'and says what it could not find' );
}

# THE BUG THIS FILE MISSED WHEN IT SHIPPED (DD-545, found next morning by DD-549).
#   Every case above runs in this shell's environment, which HAS PERL5LIB because
#   an interactive profile exported it. Cron, systemd units and agent tool-shells
#   have none - and under `env -i` the wrapper died at once with "Can't locate
#   Crypt/URandom.pm in @INC", naming a dependency that is declared and installed.
#
#   So the spec was green while the tool was broken in the one environment that
#   most needs it, because every case asked its question from the comfortable side.
#   The error even described the destination rather than the cause, which is how it
#   reads as a missing module instead of a missing path.
{
    my ( $out, $err, $exit ) = capture {
        system( 'env', '-i', "HOME=$ENV{HOME}", 'PATH=/usr/bin:/bin',
            $TOOL, 'tira.ticket.list', '--refs-only' );
    };
    unlike( $err, qr/Can't locate .*\.pm in \@INC/,
        'with no PERL5LIB it resolves its declared dependencies instead of reporting one as missing' );
    is( $exit >> 8, 0, 'and a scheduler can therefore actually use it' );
    like( $out, qr/DD-\d+/, 'and it still reaches the right board from that environment' );
}

# It must hand the process over rather than sit behind it. A wrapper that waits
# leaves a Perl process per board call, and on this project a long-running parent
# holding a child is how a supervisor was left unreaped.
{
    my $source = do { open my $fh, '<', $TOOL or die $!; local $/; <$fh> };
    like( $source, qr/\bexec\b/, 'the wrapper execs the real entrypoint' );
    unlike( $source, qr/\bsystem\s*\(/, 'and does not run it as a child it then waits for' );
}

done_testing;
