#!/usr/bin/env bash
# t-gate-status - the spec for gate-status.
#
# WHY THIS FILE EXISTS (DD-569)
#   gate-status had no spec, and on 2026-08-16 it reported figures from a cover_db
#   written forty hours earlier - predating HEAD and six merges - with no age
#   anywhere in its output. Its own header says it exists partly to stop "a stale
#   100.0 being reported as a fresh pass", and it does guard that DURING a run,
#   when the verdict file is older than the log. What it never did was say how old
#   a FINISHED verdict is once no run is active, which is almost always.
#
#   A reporting tool with no spec is how a line like that drifts: nothing fails
#   when its meaning quietly changes.
#
# RUNNING IT
#   bash .claude/tools/t-gate-status

set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
TOOL="$HERE/gate-status"
pass=0; fail=0

ok() { if [ "$1" = "$2" ]; then pass=$((pass+1)); echo "ok - $3"; else fail=$((fail+1)); echo "NOT OK - $3 (got '$1', wanted '$2')"; fi; }
has() { if printf '%s' "$1" | grep -qE "$2"; then pass=$((pass+1)); echo "ok - $3"; else fail=$((fail+1)); echo "NOT OK - $3 (output did not match /$2/)"; fi; }
hasnt() { if printf '%s' "$1" | grep -qE "$2"; then fail=$((fail+1)); echo "NOT OK - $3 (output matched /$2/ and should not)"; else pass=$((pass+1)); echo "ok - $3"; fi; }

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# run_with <log-age-seconds|older-than-head> <verdict-body> ... builds a finished-gate fixture and
# runs the tool against it. The tool reads fixed paths, so they are overridden
# through the environment - which is also what makes it testable at all.
run_with() {
  local age="$1" verdict="$2"
  local log="$WORK/log" vfile="$WORK/verdict"
  {
    echo "t/01-a.t .. ok"
    echo "Files=156, Tests=16863,  1397 wallclock secs"
    echo "Result: PASS"
    echo "SUITE_EXIT=0"
  } > "$log"
  printf '%s\n' "$verdict" > "$vfile"
  # The verdict must be NEWER than the log or the tool correctly refuses it as a
  # previous run's - but for the STALE case both must still be older than HEAD.
  # An earlier version of this fixture aged only the log and touched the verdict
  # to now, which made the verdict newer than HEAD and correctly not stale: the
  # assertion failed and the TOOL was right. Ageing one artifact of a pair whose
  # relative order is itself load-bearing is how a fixture tests something other
  # than what it names.
  # AGE IS MEANINGLESS AGAINST A MOVING REFERENCE (DD-643).
  #
  # The tool decides staleness with `verdict_epoch -lt head_epoch`, so an artifact
  # meant to read as OLD must be older than HEAD's COMMIT - not merely old by the
  # wall clock. This fixture used a fixed 144000s (~40h) for that case, which is
  # only older than HEAD while the repo has been committed to within the last 40
  # hours. Master sat idle from 2026-08-20 to 2026-08-29; the fixture's "old"
  # verdict became NEWER than HEAD, the tool correctly declined to call it stale,
  # and this spec reddened master for eight days while the code it tests was right.
  #
  # The caller now says which it means. `older-than-head` is computed from HEAD and
  # cannot rot; a plain number still means "this many seconds before now", which is
  # what the fresh cases want and what they have always meant.
  local base
  if [ "$age" = 'older-than-head' ]; then
    local head_ct
    head_ct=$(git log -1 --format=%ct 2>/dev/null || echo 0)
    # No git, no HEAD to be older than - fall back to a large clock age so the
    # fixture still builds something old rather than silently building something new.
    if [ "$head_ct" -gt 0 ]; then base=$(( head_ct - 3600 )); else base=$(( $(date +%s) - 144000 )); fi
  else
    base=$(( $(date +%s) - age ))
  fi
  touch -d "@$base" "$log"
  touch -d "@$(( base + 30 ))" "$vfile"
  DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1
}

# THE DEFECT THIS FILE WAS WRITTEN FOR: a finished verdict must say how old it is.
out="$(run_with older-than-head 'coverage gate: 100.0 everywhere
GATE_EXIT=0')"
has "$out" 'AGE|ago|STALE' 'a finished verdict states how old its figures are'

# CONTRACT DELIBERATELY MOVED (DD-582), and this assertion changed with it rather
# than being deleted or quietly edited to pass.
#
# It used to read: `has "$out" 'STALE'`, justified as "a measurement of a tree that
# no longer exists is not a verdict on this one". That justification is the defect.
# Being older than HEAD does NOT mean the tree changed - a merge commit changes no
# files, and on 2026-08-17 exactly that produced a "not a verdict on the current
# code" headline about a figure describing HEAD byte for byte.
#
# What SURVIVES is the purpose: an old figure must never be presented as current,
# and must not exit 0. That is what is asserted now. The word STALE is reserved for
# the case where the trees are known to differ, which this fixture cannot claim -
# its verdict records no tree at all.
has "$out" 'STALE|does not record which tree|unknown' 'an old figure is flagged, never presented as current'
run_with older-than-head 'coverage gate: 100.0 everywhere
GATE_EXIT=0' >/dev/null 2>&1
stale_exit=$?
ok "$stale_exit" "2" 'and it does not exit 0 - the load-bearing half, which no wording can satisfy by accident'

# A genuinely fresh pass must still read as a pass, or the line cries wolf and
# stops being read - which is the failure mode that makes a guardrail worthless.
fresh="$(run_with 5 'coverage gate: 100.0 everywhere
GATE_EXIT=0')"
hasnt "$fresh" 'STALE' 'a fresh verdict is not marked stale'

# The exit status must remain usable by a caller: that is the field a summary
# cannot mangle by truncation.
run_with 5 'coverage gate: 100.0 everywhere
GATE_EXIT=0' >/dev/null 2>&1
ok "$?" "0" 'a fresh passing gate exits 0'


# THE DOCUMENTATION IS LOAD-BEARING (DD-576). board-pulse branches on this tool's
# exit status, so the contract is not a nicety - and it went undocumented for the
# whole night after DD-569 introduced it, because nothing failed when it was
# missing. Now something does.
header="$(sed -n '1,/^LOG=/p' "$TOOL")"
for code in 0 1 2 3; do
  if printf '%s' "$header" | grep -qE "^#[[:space:]]+$code[[:space:]]+[a-z]"; then
    pass=$((pass+1)); echo "ok - exit code $code is documented in the header"
  else
    fail=$((fail+1)); echo "NOT OK - exit code $code is returnable but undocumented"
  fi
done


# DD-578: when nothing recorded a verdict, say so and say WHEN coverage ran -
# never infer that it passed. The old message blamed "a previous run", which was
# wrong in the case that actually happens here: the run was tonight's, and what
# is missing is the harness that would have recorded its result.
{
  covdb="$WORK/cover_db"; mkdir -p "$covdb"
  log="$WORK/l2"; vfile="$WORK/v2"
  { echo "t/01-a.t .. ok"; echo "Files=1, Tests=1"; echo "Result: PASS"; echo "SUITE_EXIT=0"; } > "$log"
  echo 'stale' > "$vfile"
  touch -d "@$(( $(date +%s) - 7200 ))" "$vfile"   # verdict older than the log
  touch "$log"
  touch "$covdb"                                    # coverage ran just now
  out="$(DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_COVER_DB="$covdb" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
  has   "$out" 'no verdict was recorded'  'an unrecorded verdict is described as such, not blamed on a previous run'
  has   "$out" 'COVERAGE RAN'             'and the tool reports WHEN coverage last ran, from cover_db'
  # AND MAKES NO CLAIM ABOUT WHICH TREE IT GRADED. cover_db is Devel::Cover's and
  # records no tree, so "it measured this tree" and "it did not measure this tree"
  # were both inferred from a timestamp - the same fault as the verdict path, one
  # block up in the same file, found minutes after fixing that one and only because
  # the tool was pointed at its own board.
  hasnt "$out" 'so it measured this tree|so it did not measure this tree' 'and claims nothing about WHICH tree cover_db graded, which it cannot know'
  has   "$out" 'unknown from here'        'saying plainly that it is unknown'
}

# THE OTHER BRANCH. The case above touches cover_db to "now", so it only ever
# exercises the newer-than-HEAD path. Mutating the older-than-HEAD line changed
# nothing and the spec still passed 24/24 - which is how I learned that half this
# block had no test at all. An assertion that cannot fail is not an assertion, and
# pinning one branch while leaving its twin free to regress is the shape this file
# already has a comment about.
{
  log="$WORK/oldcov.log"; vfile="$WORK/oldcov.verdict"; covdb="$WORK/oldcov_db"
  mkdir -p "$covdb"
  { echo "t/01-a.t .. ok"; echo "Result: PASS"; echo "SUITE_EXIT=0"; } > "$log"
  printf 'coverage gate: 100.0 everywhere\nGATE_EXIT=0\n' > "$vfile"
  touch -d "@$(( $(date +%s) - 7200 ))" "$vfile"
  touch "$log"
  touch -d "@$(( $(date +%s) - 7200 ))" "$covdb"     # coverage ran BEFORE the newest commit
  out="$(DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_COVER_DB="$covdb" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
  has   "$out" 'COVERAGE RAN' 'an OLD cover_db is still reported with its age'
  hasnt "$out" 'so it measured this tree|so it did not measure this tree' 'and the older-than-HEAD branch claims nothing about the tree either'
  hasnt "$out" 'GATE: PASS|totals are 100' 'but never reports a PASS - a database proves a run happened, not that it succeeded'
}

# DD-582: AN UNMARKED LOG IS NOT EVIDENCE THAT ANYTHING IS RUNNING.
#
# The tool decided this from ONE fact - the log carries no SUITE_EXIT marker -
# and then printed "RUNNING", which is a claim about a PROCESS made by looking
# only at a FILE. Observed on 2026-08-17: after an orphaned coverage tree was
# killed, this read "RUNNING: 139 files, log written 287s ago" for processes
# that no longer existed, and would have read it for ever, because nothing was
# left to write a marker.
#
# Marker-absence has several causes and only one of them is "still running": a
# hand-typed prove (the command CLAUDE.md documents) marks nothing, and neither
# does SIGKILL or a crash.
#
# DELIBERATELY NOT a staleness threshold. This tool's own header records that
# process-based liveness detection failed in BOTH directions in one evening; an
# age cutoff is the same inference with arithmetic in front of it. The age is
# already measured and is the real discriminator - the headline must simply stop
# overstating it.
{
  log="$WORK/unmarked.log"; vfile="$WORK/unmarked.verdict"
  printf 't/01-one.t .. ok
t/02-two.t .. ok
' > "$log"
  : > "$vfile"
  touch -d '5 minutes ago' "$log"
  out="$(DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
  hasnt "$out" 'RUNNING'          'an unmarked log makes NO claim that a run is in progress'
  has   "$out" 'NO VERDICT'       'it reports what it actually knows - that no verdict was recorded'
  has   "$out" '[0-9]+s ago'      'and states the age, which is the real discriminator'
  has   "$out" '2 files'          'while keeping the useful detail it already had'
}


# REGRESSION GUARD (DD-582). Recording TREE= in the verdict pushed the gate's own
# summary line out of a `tail -2` display, so the headline showed GATE_EXIT and a
# tree hash while "totals are 100.0" disappeared. Caught by looking at the output,
# not by any assertion - so here is the assertion.
{
  log="$WORK/dlog"; vfile="$WORK/dverdict"
  { echo "t/01-a.t .. ok"; echo "Result: PASS"; echo "SUITE_EXIT=0"; } > "$log"
  printf 'coverage gate: statement, branch, condition, and subroutine totals are 100.0\nGATE_EXIT=0\nTREE=deadbeefdeadbeefdeadbeefdeadbeefdeadbeef\n' > "$vfile"
  out="$(DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
  has   "$out" 'totals are 100\.0' "the gate's OWN summary line is still shown once the tree is recorded"
  hasnt "$out" '^TREE=' 'and the tree hash is not printed at the reader'
}

# DD-582 AC-5: STALENESS IS ABOUT THE TREE, NOT ABOUT THE CLOCK.
#
# The tool decides staleness with `verdict_epoch -lt head_epoch` - the verdict
# FILE's mtime against HEAD's COMMIT TIME - and never looks at a tree. It then
# states, as fact, "it measured a tree that is no longer checked out".
#
# Observed false on 2026-08-17. Merging DD-581 produced 0a57e42, the merge commit
# for 66763ee, which introduced no file changes at all:
#
#     verdict measured at 66763ee   tree 5e8861d40206fbd337ee2b0233d8c2e29f9f3435
#     HEAD now      0a57e42          tree 5e8861d40206fbd337ee2b0233d8c2e29f9f3435
#     git diff between them          EMPTY
#
# The coverage figure applied to HEAD byte for byte and the board's headline read
# "It is not a verdict on the current code."
#
# That is the same fault as the RUNNING headline above: a cheap adjacent proxy - a
# timestamp ordering - standing in for the real question, which is whether the
# FILES changed. And the cost is not cosmetic. Every merge now cries wolf, and a
# warning that fires after every merge is one people learn to scroll past, which
# is how the stale verdict this guard exists to catch got through in the first
# place.
#
# Fixture is a real git repository, because the subject is real git objects.
{
  repo="$WORK/repo"; mkdir -p "$repo"
  ( cd "$repo"
    git init -q .
    git config user.email t@example.com; git config user.name t
    echo one > file.txt
    git add file.txt; git commit -qm first
  ) >/dev/null 2>&1
  measured_tree=$(cd "$repo" && git rev-parse HEAD^{tree})

  log="$WORK/rlog"; vfile="$WORK/rverdict"
  {
    echo "t/01-a.t .. ok"
    echo "Result: PASS"
    echo "SUITE_EXIT=0"
  } > "$log"
  printf 'coverage gate: 100.0 everywhere\nGATE_EXIT=0\nTREE=%s\n' "$measured_tree" > "$vfile"
  touch -d '2 hours ago' "$log"
  touch -d '2 hours ago' "$vfile"

  # A commit AFTER the verdict that changes no files - exactly a merge's shape.
  ( cd "$repo" && git commit -q --allow-empty -m "merge-shaped, no file changes" ) >/dev/null 2>&1

  out="$(cd "$repo" && DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
  hasnt "$out" 'no longer checked out' 'a commit that changed NO files does not invalidate the verdict'
  hasnt "$out" 'not a verdict on the current code' 'and the tool does not deny a verdict it demonstrably still describes'

  # Now genuinely change the tree. The guard must still fire - the point is to make
  # it accurate, never to weaken it.
  ( cd "$repo" && echo two > file.txt && git add file.txt && git commit -qm "a real change" ) >/dev/null 2>&1
  out2="$(cd "$repo" && DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
  has "$out2" 'STALE' 'a commit that DID change files is still reported stale'

  # A verdict that never recorded its tree must say it cannot tell, rather than
  # assert either way. An honest unknown is the one answer that is never wrong.
  printf 'coverage gate: 100.0 everywhere\nGATE_EXIT=0\n' > "$vfile"
  touch -d '2 hours ago' "$vfile"
  out3="$(cd "$repo" && DD_GATE_LOG="$log" DD_GATE_VERDICT="$vfile" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
  has "$out3" 'does not record|cannot tell|unknown' 'a verdict with no recorded tree says so instead of guessing'
}


# ---- DD-657: mtime read portably, and an unreadable one is not zero ----
#
# WRITTEN RED, BEFORE THE FIX. The defect: 'stat -c %Y' is GNU coreutils and BSD
# stat (macOS) rejects it, so on a Mac the tool printed "stat: illegal option --
# c", threw a shell syntax error, and reported an age of 496664 hours - while
# exiting 0. Two of the three call sites carried '2>/dev/null || echo 0', which is
# WHY it produced a number instead of failing: the guard turned an error into a
# plausible answer, and a plausible answer gets believed.
#
# These assert the SHAPE of the fix, not merely the absence of the symptom.
# CODE ONLY, NOT COMMENTS. The first cut of this grepped the raw file, which
# would have forbidden the tool from DOCUMENTING the defect it guards against -
# the fix's own explanatory comment names 'stat -c' three times, and a spec that
# fails on that is punishing the explanation rather than the behaviour.
body_gs="$(sed 's/[[:space:]]*#.*$//' "$TOOL")"

hasnt "$body_gs" 'stat -c' \
      'no EXECUTABLE line uses GNU-only "stat -c" to read a modification time'
hasnt "$body_gs" 'mtime.*\|\| echo 0|_dd_mtime.*\|\| echo 0' \
      'no mtime lookup substitutes epoch 0 for a value it could not read'
has "$body_gs" 'stat shift' \
      'gate-status reads mtimes through perl, which means the same on GNU and BSD'

# ONE helper, not three call sites - three copies of an idiom is how two of them
# grew a different fallback from the third in the first place.
helper_defs="$(printf '%s' "$body_gs" | grep -c '_dd_mtime()' || true)"
ok "$helper_defs" "1" "there is exactly one mtime helper definition"

# THE FAILURE PATH: the assertion that would have caught the original defect, and
# the one no existing spec had - every other test hands gate-status a readable file.
unread="$(mktemp -d)"
printf 't/00.t .. ok\nResult: PASS\nSUITE_EXIT=0\n' > "$unread/gate2.log"
printf 'GATE_EXIT=0\nTREE=deadbeef\n' > "$unread/verdict.txt"
un_out="$(DD_GATE_LOG="$unread/gate2.log" DD_GATE_VERDICT="$unread/nonexistent.txt" DD_GATE_REPORT="$WORK/none" bash "$TOOL" 2>&1)"
rm -rf "$unread"
hasnt "$un_out" '[0-9]{5,}h' \
      'a missing verdict never renders as a huge fabricated age'

echo "1..$((pass+fail))"
[ "$fail" -eq 0 ] && echo "PASS ($pass assertions)" || { echo "FAIL ($fail of $((pass+fail)))"; exit 1; }
