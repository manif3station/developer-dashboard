#!/usr/bin/env perl

# t-ft99-sweep - the spec for the FT99 board sweep.
#
# WHY THIS FILE EXISTS (DD-495, 2026-08-08)
#   ft99-sweep is the only automated statement this project makes about whether
#   its board still describes reality, and until now nothing checked the checker.
#   That is precisely the arrangement this project has already been bitten by
#   twice: a guardrail whose clean report nobody had ever seen it earn (DD-493,
#   where the sweep had never executed at all), and a rule that could only ever
#   come back red (this ticket).
#
#   So the properties asserted here are deliberately about the sweep's VERDICTS,
#   not its plumbing. Each rule is exercised in both directions - a case it must
#   report and a case it must not - because a rule that only ever fires, and a
#   rule that never fires, both look like working code and neither is a check.
#
# RUNNING IT
#   PERL5LIB="$HOME/perl5/lib/perl5" prove -v .claude/tools/t-ft99-sweep

use strict;
use warnings;

use Test::More;
use FindBin;
use File::Spec;
use File::Temp qw(tempdir);
use Capture::Tiny qw(capture);

my $SWEEP = File::Spec->catfile( $FindBin::Bin, 'ft99-sweep' );

# Requiring rather than running: the script ends `exit main() if !caller`, so a
# require gives access to its subs without executing the sweep.
require $SWEEP;

# Purpose: build one board record with only the fields the sweep actually reads,
#          so a test reads as the situation it describes rather than as a fixture.
# Input:   %overrides - any record field, typically ref/column/assignee/linkage
# Output:  hashref shaped like one d2 tira.<type>.list --full record
sub card {
    my (%overrides) = @_;
    return {
        ref      => 'DD-000',
        column   => 'todo',
        assignee => 'DD Bot',
        linkage  => { links => [], ticket_refs => [], sub_epic_refs => [] },
        questions => [],
        # A well-formed card being worked records the work tree it is worked in,
        # so the default fixture carries one and a test that cares about its
        # absence says so explicitly.
        sandbox      => $FindBin::Bin,
        last_updated => stamp_hours_ago(0),
        %overrides,
    };
}

# Purpose: an ISO stamp a given number of hours in the past, so a test can say
#          "this card has not moved for a day" without sleeping for one.
# Input:   hours
# Output:  stamp string in the board's own format
sub stamp_hours_ago {
    my ($hours) = @_;
    my @t = gmtime( time - $hours * 3600 );
    return sprintf( '%04d-%02d-%02dT%02d:%02d:%02d+0000',
        $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0] );
}

# Purpose: a question as the board returns one.
# Input:   %overrides - typically answer/discarded_at
# Output:  hashref
sub question {
    my (%overrides) = @_;
    return { id => 'Q-001', text => 'A question', %overrides };
}

# Purpose: run the sweep's rules over a single-ticket board.
# Input:   $record
# Output:  arrayref of findings
sub sweep_one {
    my ($record) = @_;
    return main::sweep( { ticket => [$record] } );
}

# Purpose: answer "did the sweep report this ref?", which is the only question
#          any of these assertions actually cares about.
# Input:   $findings arrayref, $ref
# Output:  the matching finding's text, or undef
sub reported {
    my ( $findings, $ref ) = @_;
    for my $finding ( @{$findings} ) {
        return $finding->{why} if $finding->{ref} eq $ref;
    }
    return undef;
}

# --------------------------------------------------------------------------
# AC-1 / AC-2 / AC-5: the blocked-by-michael rule decides for itself.
# --------------------------------------------------------------------------

{
    # Parked on him with a question he has not answered: legitimate, stays quiet.
    my $findings = sweep_one( card(
        ref => 'DDE-001', column => 'blocked-by-michael',
        questions => [ question( id => 'Q-050' ) ],
    ) );
    is( reported( $findings, 'DDE-001' ), undef,
        'a card parked on him with an unanswered question is not reported' );
}

{
    # Parked on him with nothing left to answer. This is the case that sat on the
    # real board all morning while the sweep called it clean, because the old rule
    # asked a retired markdown page instead of the card.
    my $findings = sweep_one( card(
        ref => 'DD-516', column => 'blocked-by-michael',
        questions => [ question( id => 'Q-051', answer => { text => 'settled' } ) ],
    ) );
    my $why = reported( $findings, 'DD-516' );
    ok( defined $why, 'a card parked on him with every question answered is reported' );
    like( $why // '', qr/nothing is actually waiting on him/,
        'the finding says what is wrong, not merely that something is' );
}

{
    # A discarded question is not waiting on anybody either.
    my $findings = sweep_one( card(
        ref => 'DD-517', column => 'blocked-by-michael',
        questions => [ question( id => 'Q-052', discarded_at => '2026-08-09T00:00:00+0000' ) ],
    ) );
    ok( defined reported( $findings, 'DD-517' ),
        'a card parked on him whose only question was discarded is reported' );
}

{
    # The mirror, and the one that HIDES work rather than stalling it: an
    # unanswered question anywhere else is waiting on him where he will not look.
    # This was live on the real board - Q-002 sat on a DISCARDED card.
    my $findings = sweep_one( card(
        ref => 'DD-511', column => 'discard',
        questions => [ question( id => 'Q-002' ) ],
    ) );
    my $why = reported( $findings, 'DD-511' );
    ok( defined $why, 'an unanswered question outside blocked-by-michael is reported' );
    like( $why // '', qr/Q-002/,
        'the finding names the question, so he can go straight to it' );
}

{
    # No questions at all, in an ordinary column: neither rule may fire.
    my $findings = sweep_one( card( ref => 'DD-500', column => 'todo' ) );
    is( reported( $findings, 'DD-500' ), undef,
        'the question rules leave an ordinary card alone' );
}

# --------------------------------------------------------------------------
# Sitting still. The owner asked for this explicitly: "check all cards like in
# backlog and the card sitting in progress for hours, everything".
# --------------------------------------------------------------------------

{
    my $findings = sweep_one( card(
        ref => 'DD-525', column => 'in-progress',
        last_updated => stamp_hours_ago(16),
    ) );
    my $why = reported( $findings, 'DD-525' );
    ok( defined $why, 'a card claimed but untouched for hours is reported' );
    like( $why // '', qr/has not changed for/,
        'the finding says it has stopped moving, not merely that it exists' );
}

{
    my $findings = sweep_one( card(
        ref => 'DD-526', column => 'in-progress',
        last_updated => stamp_hours_ago(1),
    ) );
    is( reported( $findings, 'DD-526' ), undef,
        'a card worked within the hour is left alone' );
}

{
    # The backlog is not a rubbish bin, but it is allowed to hold work that is
    # genuinely waiting - so the window is long, and a fresh card is silent.
    my $findings = sweep_one( card(
        ref => 'DD-527', column => 'backlog',
        last_updated => stamp_hours_ago( 30 * 24 ),
    ) );
    ok( defined reported( $findings, 'DD-527' ),
        'a card left untouched in the backlog for a month is reported' );

    my $fresh = sweep_one( card(
        ref => 'DD-528', column => 'backlog',
        last_updated => stamp_hours_ago(24),
    ) );
    is( reported( $fresh, 'DD-528' ), undef,
        'a card waiting a day in the backlog is left alone' );
}

# --------------------------------------------------------------------------
# The five rules that were already there. Changing one rule must not quietly
# alter another, and none of them had a test before this file existed.
# --------------------------------------------------------------------------

{
    my $findings = sweep_one( card( ref => 'DD-496', column => 'git-gate', assignee => '' ) );
    like( reported( $findings, 'DD-496' ) // '', qr/no assignee/,
        'a card in a working column with nobody on it is reported' );
}

{
    my $findings = sweep_one( card( ref => 'DD-497', column => 'git-gate', assignee => 'DD Bot' ) );
    is( reported( $findings, 'DD-497' ), undef,
        'a working card with an assignee is left alone' );
}

{
    my $findings = sweep_one( card( ref => 'DD-498', column => 'blocked-by-dependency' ) );
    like( reported( $findings, 'DD-498' ) // '', qr/names no blocking link/,
        'a dependency park naming no blocker is reported, because nothing can release it' );
}

{
    my $blocked = card(
        ref     => 'DD-499',
        column  => 'blocked-by-dependency',
        linkage => { links => [ { ref => 'DD-400', type => 'is-blocked-by' } ], ticket_refs => [], sub_epic_refs => [] },
    );
    my $done    = card( ref => 'DD-400', column => 'release-to-pause' );
    my $open    = card( ref => 'DD-400', column => 'in-progress' );

    my $cleared = main::sweep( { ticket => [ $blocked, $done ] } );
    like( reported( $cleared, 'DD-499' ) // '', qr/the park has cleared/,
        'a park whose blocker reached a terminal column is reported as released' );

    my $still = main::sweep( { ticket => [ $blocked, $open ] } );
    is( reported( $still, 'DD-499' ), undef,
        'a park whose blocker is still open is left alone' );
}

# DD-536: the waiting room has to be read, not just classified.
#
# Splitting Admin Done out made done-not-released a queue that drains, so a card
# still in it after a release has shipped is a card that missed one. Nothing
# checked that, and on the first day an epic sat there with its work already on
# CPAN — found by the owner from a phone screenshot, which is the sweep's job.
#
# The shipped-check is INJECTED rather than reached for, so these cases are about
# the verdict and not about git. The resolver's own two-source rule is exercised
# separately below, against this repository's real history.
{
    my $card = card( ref => 'DD-910', column => 'done-not-released' );
    my $findings = main::sweep( { ticket => [$card] }, sub { 'v4.26 as 25de3b1' } );
    like( reported( $findings, 'DD-910' ) // '', qr/already in v4\.26 as 25de3b1/,
        'a card left in the waiting room after its work shipped is reported, naming the tag and the commit' );
}

{
    my $card = card( ref => 'DD-911', column => 'done-not-released' );
    my $findings = main::sweep( { ticket => [$card] }, sub { undef } );
    is( reported( $findings, 'DD-911' ), undef,
        'a card whose work is in no release is left alone - it is legitimately waiting' );
}

{
    my $card = card( ref => 'DD-912', column => 'in-progress' );
    my $findings = main::sweep( { ticket => [$card] }, sub { 'v4.26 as 25de3b1' } );
    unlike( reported( $findings, 'DD-912' ) // '', qr/waiting room|already in v4/,
        'the rule applies to the waiting room only, not to every card whose work has shipped' );
}

# The resolver itself, against real history. Its whole value is refusing to
# believe one cheap signal: yesterday a bare hex match credited cards to commits
# titled with a RANGE of refs they never carried, and matched strings that merely
# looked like SHAs. So a hit requires two independent sources to agree.
{
    my $checker = main::shipped_checker('.');
  SKIP: {
        skip 'not a git checkout with release tags', 3 if !$checker;

        my $real = card(
            ref      => 'DD-488',
            column   => 'done-not-released',
            comments => [ { body => 'landed as 25de3b1 and pushed' } ],
        );
        like( $checker->($real) // '', qr/^v\d+\.\d+ as 25de3b1/,
            'a card citing a commit that is in the newest release tag, and whose subject names the card, is resolved as shipped' );

        my $stranger = card(
            ref      => 'DD-000',
            column   => 'done-not-released',
            comments => [ { body => 'landed as 25de3b1 and pushed' } ],
        );
        is( $checker->($stranger), undef,
            'a real shipped commit that does not name this card proves nothing about it - the range-title trap' );

        my $invented = card(
            ref      => 'DD-913',
            column   => 'done-not-released',
            comments => [ { body => 'see deadbeef1 for the fix' } ],
        );
        is( $checker->($invented), undef,
            'a hex string that is not a commit is not evidence, however much it looks like one' );
    }
}

{
    my $elsewhere = tempdir( CLEANUP => 1 );
    is( main::shipped_checker($elsewhere), undef,
        'where git cannot be consulted the resolver refuses to answer, so the caller must report could-not-look rather than clean' );
}

# The owner's grouped-questions instruction (2026-08-14): "Group every question
# you have into ONE ticket in the backlog rather than asking them one at a time
# ... I will pick that ticket up and answer all of them together."
#
# That makes backlog a place he DOES look, for this one purpose, so the rule
# below must not report it. The rule's premise is "waiting on him where he will
# not look", and its premise is what changed - not its wording.
#
# The coverage did not disappear with it: police now carries
# question-unanswered with a 12h grace and print-reminder straight to his own
# terminal, so a question waiting too long reaches him regardless of column.
{
    my $grouped = card(
        ref       => 'DD-920',
        column    => 'backlog',
        questions => [ question( id => 'Q-100' ) ],
    );
    is( reported( sweep_one($grouped), 'DD-920' ), undef,
        'a questions card parked in the backlog is left alone - the owner asked for his questions grouped there' );
}

{
    my $stranded = card(
        ref       => 'DD-921',
        column    => 'in-progress',
        questions => [ question( id => 'Q-101' ) ],
    );
    like( reported( sweep_one($stranded), 'DD-921' ) // '', qr/waiting on him where he will not look/,
        'a question stranded in a working column is still reported - the exception is the backlog, not everywhere' );
}

# Admin Done is terminal (owner's decision, 2026-08-10, answering Q-011 on
# DD-535). It exists because done-not-released was holding two unrelated states
# at once: product work waiting for a release, and work that can never have one.
# The sweep has to know, or every card the owner just moved there becomes a card
# it cannot account for - and a park waiting on one would never clear.
{
    my $blocked = card(
        ref     => 'DD-905',
        column  => 'blocked-by-dependency',
        linkage => { links => [ { ref => 'DD-906', type => 'is-blocked-by' } ], ticket_refs => [], sub_epic_refs => [] },
    );
    my $admin = card( ref => 'DD-906', column => 'admin-done' );

    my $cleared = main::sweep( { ticket => [ $blocked, $admin ] } );
    like( reported( $cleared, 'DD-905' ) // '', qr/the park has cleared/,
        'a park waiting on a card that reached Admin Done is released, because that work is finished' );
}

{
    my $findings = sweep_one( card( ref => 'DD-907', column => 'admin-done', assignee => '' ) );
    is( reported( $findings, 'DD-907' ), undef,
        'a finished admin card is not chased for having nobody on it - terminal columns are not working columns' );
}

{
    my $stale = card( ref => 'DD-908', column => 'admin-done', last_updated => stamp_hours_ago(24 * 30) );
    my $findings = sweep_one($stale);
    is( reported( $findings, 'DD-908' ), undef,
        'a finished admin card is not reported as stale however long it sits there' );
}

{
    my $parent = card(
        ref     => 'DDE-904',
        column  => 'in-progress',
        linkage => { links => [], ticket_refs => ['DD-909'], sub_epic_refs => [] },
    );
    my $child = card( ref => 'DD-909', column => 'admin-done' );
    my $findings = main::sweep( { epic => [$parent], ticket => [$child] } );
    like( reported( $findings, 'DDE-904' ) // '', qr/every one of its 1 children is terminal/,
        'an epic whose only child reached Admin Done is reported as finished, not left working for ever' );
}

{
    my $parent = card(
        ref     => 'DDE-900',
        column  => 'backlog',
        linkage => { links => [], ticket_refs => ['DD-901'], sub_epic_refs => [] },
    );
    my $child = card( ref => 'DD-901', column => 'in-progress' );
    my $findings = main::sweep( { epic => [$parent], ticket => [$child] } );
    like( reported( $findings, 'DDE-900' ) // '', qr/children have already started/,
        'an epic parked while its children work is reported - the failure this board actually suffered' );
}

{
    my $parent = card(
        ref     => 'DDE-902',
        column  => 'in-progress',
        linkage => { links => [], ticket_refs => ['DD-903'], sub_epic_refs => [] },
    );
    my $child = card( ref => 'DD-903', column => 'release-to-pause' );
    my $findings = main::sweep( { epic => [$parent], ticket => [$child] } );
    like( reported( $findings, 'DDE-902' ) // '', qr/every one of its 1 children is terminal/,
        'a parent still working while every child is finished is reported' );
}

# --------------------------------------------------------------------------
# AC-3: "could not look" is never "clean".
#
# Run as a subprocess, because the property under test is the process's EXIT
# STATUS - the thing cron and any future CI step will actually read. Asserting
# it in-process would test a return value nobody consumes.
# --------------------------------------------------------------------------

{
    my $tmp     = tempdir( CLEANUP => 1 );
    my $log     = File::Spec->catfile( $tmp, 'ft99.log' );
    # A HOME with no board under it: the sweep can run but cannot read anything.
    my ( $stdout, $stderr, $exit ) = capture {
        local $ENV{DD_FT99_LOG} = $log;
        local $ENV{HOME}        = File::Spec->catdir( $tmp, 'no-such-home' );
        system( $^X, $SWEEP );
    };

    is( $exit >> 8, 3, 'AC-3 a board that cannot be read exits 3' );
    like( "$stdout$stderr", qr/UNUSABLE/,
        'AC-3 it says UNUSABLE, so the failure cannot be mistaken for a finding' );
    unlike( $stdout, qr/every card is in a column its evidence supports/,
        'AC-3 it never prints a clean verdict it did not earn' );
}

# The sandbox check, MOVED here from police (2026-08-14). The policy rule is
# correct and caught a real omission - four sandboxes existed here and none was
# recorded on its card. But police cannot read this repository from wherever it
# runs: it reports zero branches and no work trees at all, and says so itself. The
# rule therefore returned the same answer for every card whatever the truth was,
# four times, escalating to urgent. A rule that can only come back red teaches its
# reader to skim the channel - worse than no rule, because it still looks like one.
#
# The check is not abandoned. It is moved to the one place that CAN see the
# repository: the checkout this sweep runs in.
{
    my $claimed = card( ref => 'DD-930', column => 'in-progress', sandbox => '/nowhere/that/exists' );
    like( reported( sweep_one($claimed), 'DD-930' ) // '', qr/work tree/,
        'a card being worked whose recorded work tree is not there is reported' );
}

{
    my $none = card( ref => 'DD-931', column => 'in-progress', sandbox => '' );
    like( reported( sweep_one($none), 'DD-931' ) // '', qr/work tree/,
        'a card being worked that records no work tree at all is reported' );
}

{
    my $fine = card( ref => 'DD-932', column => 'in-progress', sandbox => $FindBin::Bin );
    is( reported( sweep_one($fine), 'DD-932' ), undef,
        'a card whose recorded work tree exists is left alone' );
}

{
    my $waiting = card( ref => 'DD-933', column => 'todo', sandbox => '/nowhere/that/exists' );
    is( reported( sweep_one($waiting), 'DD-933' ), undef,
        'a card that is not being worked is never asked for a work tree' );
}

done_testing();
