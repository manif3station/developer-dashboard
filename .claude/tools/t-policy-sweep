#!/usr/bin/env perl

# t-policy-sweep - the spec for the hourly policy reconciliation.
#
# WHY THIS FILE EXISTS (DD-542)
#   policy-sweep is the only thing that will notice a declared policy going
#   missing, or a rule Tira gains that nobody here has judged. Both drifts are
#   silent by construction: police simply stops mentioning a rule, and an
#   undeclared rule is quiet in exactly the way an obeyed one is.
#
#   So the properties asserted here are about the sweep's DECISIONS - what it
#   restores, what it refuses to restore, and what it reports as needing a
#   person - and every rule is exercised in both directions, because a rule that
#   only ever fires and a rule that never fires both look like working code.
#
# RUNNING IT
#   PERL5LIB="$HOME/perl5/lib/perl5" prove -v .claude/tools/t-policy-sweep

use strict;
use warnings;

use Test::More;
use FindBin;
use File::Spec;

my $SWEEP = File::Spec->catfile( $FindBin::Bin, 'policy-sweep' );
require $SWEEP;

# Purpose: the three inputs the sweep reconciles, as it receives them.
# Input:   %overrides for catalogue/live/manifest
# Output:  the three structures
sub inputs {
    my (%o) = @_;
    return (
        $o{catalogue} // [qw(card-unassigned wip-limit gate-missing checklist-idle)],
        $o{live}      // [ { rule => 'card-unassigned', action => 'bridge-reminder' } ],
        $o{manifest}  // {
            declared => [ { rule => 'card-unassigned', action => 'bridge-reminder' } ],
            declined => [ { rule => 'checklist-idle', reason => 'no checklists here' } ],
        },
    );
}

# Purpose: answer "what did the sweep decide about this rule?".
# Input:   the plan hashref and a rule name
# Output:  the bucket name, or undef
sub bucket_of {
    my ( $plan, $rule ) = @_;
    for my $bucket (qw(ok restore redecline new)) {
        return $bucket if grep { ( ref $_ ? $_->{rule} : $_ ) eq $rule } @{ $plan->{$bucket} || [] };
    }
    return undef;
}

# AC-1: a declared policy that has gone missing is restored, with its arguments.
{
    my ( $catalogue, $live, $manifest ) = inputs(
        manifest => {
            declared => [
                { rule => 'card-unassigned', action => 'bridge-reminder' },
                { rule => 'wip-limit', action => 'bridge-reminder', column => 'in-progress', max => 1 },
            ],
            declined => [],
        },
    );
    my $plan = main::reconcile( $catalogue, $live, $manifest );

    is( bucket_of( $plan, 'wip-limit' ), 'restore', 'a declared policy missing from the board is restored' );
    is( bucket_of( $plan, 'card-unassigned' ), 'ok', 'a policy that is still declared is left alone' );

    my ($restored) = grep { $_->{rule} eq 'wip-limit' } @{ $plan->{restore} };
    is( $restored->{column}, 'in-progress', 'the restoration carries the arguments that were decided, not just the rule name' );
    is( $restored->{max}, 1, 'and every argument, so a restored rule is the rule that was agreed rather than a default' );
}

# AC-2: a decline that has been lost is re-declined WITH ITS ORIGINAL REASON.
# The reason is the whole point of a decline - without it the record cannot tell
# "somebody decided against this" from "nobody has looked".
{
    my ( $catalogue, $live, $manifest ) = inputs();
    my $plan = main::reconcile( $catalogue, $live, $manifest, [] );

    is( bucket_of( $plan, 'checklist-idle' ), 'redecline', 'a lost decline is re-declined' );
    my ($again) = grep { $_->{rule} eq 'checklist-idle' } @{ $plan->{redecline} };
    like( $again->{reason} // '', qr/no checklists here/, 'the original reason travels with it' );
}

{
    my ( $catalogue, $live, $manifest ) = inputs();
    my $plan = main::reconcile( $catalogue, $live, $manifest, ['checklist-idle'] );
    is( bucket_of( $plan, 'checklist-idle' ), 'ok', 'a decline that is still recorded is left alone' );
}

# AC-3: THE ONE THAT MUST NOT BE AUTOMATED. A rule Tira ships that nobody here
# has judged is reported, never declared. Declaring it would police work nobody
# agreed to police, and would do so under the appearance of a decision.
{
    my ( $catalogue, $live, $manifest ) = inputs(
        catalogue => [qw(card-unassigned checklist-idle brand-new-rule)],
    );
    my $plan = main::reconcile( $catalogue, $live, $manifest, ['checklist-idle'] );

    is( bucket_of( $plan, 'brand-new-rule' ), 'new', 'a rule nobody has judged is reported as new' );
    is( scalar( grep { $_->{rule} eq 'brand-new-rule' } @{ $plan->{restore} } ), 0,
        'and is NOT queued for declaration - judging it is a person\'s job' );
}

# AC-5: every rule lands in exactly one bucket, and the sweep says so. A rule
# that quietly falls through is the failure this whole job exists to prevent.
{
    my ( $catalogue, $live, $manifest ) = inputs(
        catalogue => [qw(card-unassigned wip-limit checklist-idle brand-new-rule)],
        manifest  => {
            declared => [ { rule => 'card-unassigned' }, { rule => 'wip-limit' } ],
            declined => [ { rule => 'checklist-idle', reason => 'no checklists here' } ],
        },
    );
    my $plan = main::reconcile( $catalogue, $live, $manifest, [] );
    my $counted = scalar( @{ $plan->{ok} } ) + scalar( @{ $plan->{restore} } )
      + scalar( @{ $plan->{redecline} } ) + scalar( @{ $plan->{new} } );
    is( $counted, 4, 'all four catalogue rules are accounted for, none silently dropped' );
    is( $plan->{total}, 4, 'and the sweep reports the total it accounted for' );
}

# A rule this project declared that Tira has REMOVED is not a restoration
# candidate: re-declaring a rule the tool no longer has would fail every hour.
{
    my ( $catalogue, $live, $manifest ) = inputs(
        catalogue => [qw(card-unassigned)],
        manifest  => { declared => [ { rule => 'card-unassigned' }, { rule => 'retired-rule' } ], declined => [] },
    );
    my $plan = main::reconcile( $catalogue, $live, $manifest, [] );
    is( bucket_of( $plan, 'retired-rule' ), undef, 'a manifest rule Tira no longer ships is not restored' );
    like( join( ' ', @{ $plan->{retired} || [] } ), qr/retired-rule/,
        'it is reported as retired instead, so the manifest can be corrected deliberately' );
}

# The bug this parser actually had on its first real run against the live
# document: the ACTIONS table uses the identical row shape, so a document-wide
# match reported bridge-reminder, print-reminder and log-only as rules - three
# things that can never be declared, offered as needing a decision every hour.
{
    my $doc = <<'DOC';
## The rules

| Rule | Arguments | What it is for |
| --- | --- | --- |
| `card-unassigned` | — | work with nobody on it |
| `wip-limit` | `--column` | too many things at once |

## The actions

| Action | Where it goes | Use it when |
| --- | --- | --- |
| `bridge-reminder` | the agent |. you want the agent to act |
| `log-only` | nowhere | while tuning |
DOC

    my $rules = main::parse_catalogue($doc);
    is_deeply( $rules, [qw(card-unassigned wip-limit)],
        'only the rules table is parsed - actions are not rules and can never be declared' );
}

{
    my $wrong_shape = "## Something else\n\n| `card-unassigned` | x |\n\n## Next\n";
    my $died = !eval { main::parse_catalogue($wrong_shape); 1 };
    ok( $died, 'a catalogue whose format has changed is a loud failure, not an empty rule list' );
}

# A rule DECLINED on the board must never be restored from the manifest. This is
# not hypothetical: on 2026-08-14 card-sandbox-missing was declined with a written
# reason at 17:26, and this sweep put it back within the hour because the manifest
# still listed it as declared. The rule then escalated to urgent again.
#
# A decline is a decision with a reason attached, made later than the file. A
# checker that silently reverses a recorded decision is worse than no checker: it
# looks like the decision never happened.
{
    my ( $catalogue, $live, $manifest ) = inputs(
        catalogue => ['card-unassigned'],
        live      => [],
        manifest  => { declared => [ { rule => 'card-unassigned' } ], declined => [] },
    );
    my $plan = main::reconcile( $catalogue, $live, $manifest, ['card-unassigned'] );

    is( bucket_of( $plan, 'card-unassigned' ), 'ok',
        'a rule the board has DECLINED is not restored from the manifest, however the manifest describes it' );
    is( scalar @{ $plan->{restore} }, 0, 'and nothing is queued to re-declare it' );
    like( join( ' ', @{ $plan->{conflicts} || [] } ), qr/card-unassigned/,
        'the disagreement is reported, so the manifest can be corrected deliberately' );
}

done_testing;

__END__

=head1 NAME

t/t-policy-sweep - the spec for the hourly policy reconciliation

=head1 PURPOSE

Verify that C<policy-sweep> restores what this project decided, refuses to
decide anything by itself, and accounts for every rule Tira ships.

=head1 WHY IT EXISTS

Two drifts are silent by construction. A declared policy that disappears leaves
no trace, because police simply stops mentioning that rule while continuing to
speak about everything else - which reads as compliance. And a rule added in a
future Tira release is never considered here at all, because nobody is told
about a capability they never had.

The spec is written against the sweep's decisions rather than its plumbing, and
asserts both directions of each rule, because a check that only ever fires and
one that never fires both look like working code and neither is a check.

=head1 WHEN TO USE

Whenever C<policy-sweep> or the manifest format changes.

=head1 HOW TO USE

    PERL5LIB="$HOME/perl5/lib/perl5" prove -v .claude/tools/t-policy-sweep

=head1 WHAT USES IT

Nothing in the shipped product. C<policy-sweep> is operator tooling under
C<.claude/>, which is excluded from the release tarball.

=head1 EXAMPLES

The property that matters most is a refusal:

    a rule Tira ships that nobody here has judged is reported as NEW,
    and is never declared automatically.

=cut
