#!/bin/bash
# gate-status - is the coverage gate running, and is its verdict THIS run's?
#
# Written after both failure modes of a process check bit in one evening. A
# pattern loose enough to match the searching command reported a finished gate as
# running for 28 minutes; a pattern tight enough to match nothing reported a
# running gate as finished. Both were confident and both were wrong.
#
# So this asks the ARTIFACTS, which cannot misidentify themselves: the log's own
# growth, and whether the verdict file is newer than the log's first line. A
# verdict older than the run is the previous run's - reading it as this one's is
# how a stale 100.0 gets reported as a fresh pass.
# Overridable so the spec can control its own inputs (DD-569). Without this the
# spec's fixtures were silently ignored and two of its assertions passed against
# the real files - a check aimed at the wrong subject can only return the answer
# it hoped for, which is the fault this tool exists to catch in others.
# Exit codes, documented because board-pulse BRANCHES on them (DD-576). They were
# introduced by DD-569 and left unstated, so the contract driving the board's
# headline indicator lived only in the two files that shared it - and a change
# here could silently make the pulse misreport, which is the failure DD-569
# existed to end. t-gate-status asserts every code below appears here, so adding
# one without documenting it fails rather than merely being untidy:
#     0  finished, and the verdict says the gate passed
#     1  running, or finished with a verdict that says it failed
#     2  the figures do not describe the current tree - the verdict belongs to a
#        previous run, or it predates HEAD, or the run discarded coverage because
#        the tree moved under it. NOT a pass and NOT a failure: a non-answer.
#     3  no log at all - the gate has never run here
#
# WHAT THIS TOOL DOES NOT WATCH (DD-578), stated because a blind spot nobody
# declared is indistinguishable from one nobody has. A PASS/FAIL verdict is
# written only by the dd-tg integrator harness, which last ran on 2026-08-14.
# script/coverage-gate - the project's real four-metric gate - writes none of
# these files, so running it directly cannot turn this green however well it
# does. What that run DOES leave behind is cover_db, and its timestamp is
# reported below: it says WHEN coverage last ran, never WHETHER it passed. Those
# are different questions and this tool keeps them apart.

# ARTIFACT PATHS ARE PER-CHECKOUT, NOT PER-MACHINE (DD-652).
#
# These defaulted to a fixed /tmp name shared by every sandbox, worktree and
# session on the host. Measured: a coverage run in one sandbox completed with
# GATE_EXIT=0 and its verdict was already gone, overwritten by another sandbox's
# run seven minutes earlier - and the two were indistinguishable by content,
# because TREE records HEAD's tree and two sandboxes on the same commit produce
# the same hash while carrying different uncommitted work, which is what a
# sandbox gate actually grades.
#
# Deriving from this script's own location makes each checkout independent with
# no git call and no configuration - the same shape gate-status already uses for
# cover_db. The DD_* environment overrides still win, so anything that set them
# explicitly is unaffected.
_dd_here="$(cd "$(dirname "$0")" && pwd)" || {
  echo "$(basename "$0"): cannot resolve my own location; refusing to guess a state directory" >&2
  exit 3
}
DD_STATE_DIR="$(dirname "$_dd_here")/state"
mkdir -p "$DD_STATE_DIR" || {
  echo "$(basename "$0"): cannot create $DD_STATE_DIR" >&2
  exit 3
}
LOG=${DD_GATE_LOG:-$DD_STATE_DIR/gate2.log}
VERDICT=${DD_GATE_VERDICT:-$DD_STATE_DIR/gate2-verdict.txt}
[ -f "$LOG" ] || { echo "gate-status: no log at $LOG - the gate has never run here"; exit 3; }

files=$(grep -c '^t/' "$LOG" 2>/dev/null)
log_age=$(( $(date +%s) - $(stat -c %Y "$LOG") ))
done_marker=$(grep -c 'SUITE_EXIT' "$LOG" 2>/dev/null)

if [ "$done_marker" -eq 0 ]; then
  # NO LIVENESS CLAIM (DD-582). This said "RUNNING", decided from one fact: the
  # log carries no SUITE_EXIT marker. That is a claim about a PROCESS made by
  # looking only at a FILE, and marker-absence has several causes of which only
  # one is "still running" - a hand-typed `prove -lr t`, the command CLAUDE.md
  # documents as standard, marks nothing, and neither does SIGKILL or a crash.
  # After an orphaned coverage tree was killed on 2026-08-17 this read
  # "RUNNING: 139 files, log written 287s ago" for processes that no longer
  # existed, and would have said it for ever.
  #
  # Deliberately NOT a staleness threshold instead: this file's own header records
  # that process-based liveness detection failed in BOTH directions in a single
  # evening, and an age cutoff is that same inference with arithmetic in front of
  # it. The age is already measured and is the real discriminator.
  echo "NO VERDICT: $files files logged, last written ${log_age}s ago - no end marker, so whether a run is still going cannot be told from here"
  [ "$log_age" -gt 900 ] && echo "  WARNING: the log has not grown for ${log_age}s - check the process tree, this is what a wedge looks like"
  exit 1
fi

if [ ! -f "$VERDICT" ] || [ "$VERDICT" -ot "$LOG" ]; then
  echo "FINISHED but no verdict was recorded for this run - the file present is older than the log"

  # cover_db is what a direct script/coverage-gate run actually leaves behind, so
  # it can answer WHEN even when nothing answered WHETHER. Deliberately not
  # treated as a pass: a database proves a run happened, never that it succeeded,
  # and this project has already acted on a figure that measured a tree it could
  # not attribute.
  COVER_DB=${DD_GATE_COVER_DB:-$(dirname "$0")/../../cover_db}
  if [ -d "$COVER_DB" ]; then
    cov_epoch=$(stat -c %Y "$COVER_DB" 2>/dev/null || echo 0)
    head_epoch=$(git log -1 --format=%ct 2>/dev/null || echo 0)
    cov_age=$(( $(date +%s) - cov_epoch ))
    printf '  COVERAGE RAN %dh%02dm ago' $(( cov_age / 3600 )) $(( (cov_age % 3600) / 60 ))
    # THE SAME UNEARNED CLAIM, ONE BLOCK UP (DD-582, found minutes after fixing the
    # verdict path in this same file). This said "so it measured this tree" or "so
    # it did not measure this tree" from a timestamp ordering alone. A commit made
    # after a coverage run does not mean the files changed - a merge changes none -
    # and one made before it does not mean they did.
    #
    # Unlike the verdict, cover_db is written by Devel::Cover and records no tree,
    # so this genuinely CANNOT be known here. The honest report is the age plus the
    # absence, and it is worth more than a confident guess: a reader told the tree
    # is unknown goes and checks, a reader told it did not measure this tree does not.
    if [ "$head_epoch" -gt 0 ] && [ "$cov_epoch" -gt "$head_epoch" ]; then
      echo " - after the newest commit, though cover_db records no tree, so whether it graded THIS one is unknown from here; and no verdict was recorded, so whether it PASSED is unknown too"
    else
      echo " - before the newest commit, and cover_db records no tree, so whether it graded this one is unknown from here"
    fi
  fi
  exit 2
fi

echo "FINISHED: $(grep -E '^(Files=|Result:)' "$LOG" | tail -2 | tr '\n' ' ')"
# TREE= is bookkeeping for the comparison below, not a line for a reader - and it
# must be excluded BEFORE the tail, or it pushes the gate's own summary line off
# the end. Adding it did exactly that: the display showed GATE_EXIT and a tree
# hash while "totals are 100.0" - the whole reason DD-581 made the verdict carry
# the gate's own words - silently vanished.
grep -v '^TREE=' "$VERDICT" | tail -2

# HOW OLD IS THIS, AND DOES IT DESCRIBE THE CURRENT TREE? (DD-569)
#
# On 2026-08-16 this tool reported a verdict from a cover_db written forty hours
# earlier, predating HEAD and six merges, with no age anywhere in its output. The
# header above says it exists partly to stop a stale 100.0 reading as a fresh
# pass - and it does guard that DURING a run, when the verdict is older than the
# log. Once no run is active it was reporting history as though it were now.
#
# A measurement of a tree that no longer exists is not a verdict on this one.
verdict_epoch=$(stat -c %Y "$VERDICT" 2>/dev/null || echo 0)
verdict_age=$(( $(date +%s) - verdict_epoch ))
head_epoch=$(git log -1 --format=%ct 2>/dev/null || echo 0)
printf '  AGE: this verdict was written %dh%02dm ago\n' $(( verdict_age / 3600 )) $(( (verdict_age % 3600) / 60 ))

# THE TREE, NOT THE CLOCK (DD-582). This compared the verdict FILE's mtime with
# HEAD's COMMIT TIME and then stated, as fact, that the tree had changed - a thing
# it never looked at. Shown false on 2026-08-17: merging DD-581 produced 0a57e42,
# the merge commit for 66763ee, which changed no files. Both carried tree
# 5e8861d4..., `git diff` between them was empty, and the headline read "It is not
# a verdict on the current code" about a figure describing HEAD byte for byte.
#
# A warning that fires after every merge is one people learn to scroll past, which
# is how the stale verdict this guard exists to catch got through in the first
# place. So it is made ACCURATE rather than louder: the verdict records the tree
# it measured and that is what is compared.
#
# COMPUTED ONCE, used by the message AND the exit below. They were separate tests
# of the same condition, and patching one would have left the exit contradicting
# the words - this project has a codename for fixing the instance and not the class.
measured_tree=$(sed -n 's/^TREE=//p' "$VERDICT" 2>/dev/null | tail -1)
head_tree=$(git rev-parse 'HEAD^{tree}' 2>/dev/null || true)
tree_stale=0
tree_unknown=0
if [ -n "$measured_tree" ] && [ -n "$head_tree" ]; then
  [ "$measured_tree" != "$head_tree" ] && tree_stale=1
elif [ "$head_epoch" -gt 0 ] && [ "$verdict_epoch" -lt "$head_epoch" ]; then
  # No tree recorded and a commit came after it. An honest unknown is the one
  # answer that is never wrong; asserting either way would be guessing.
  tree_unknown=1
fi
if [ "$tree_stale" -eq 1 ]; then
  echo "  STALE: it measured tree $(printf '%.10s' "$measured_tree") and HEAD is tree $(printf '%.10s' "$head_tree") - the files differ, so it is not a verdict on the current code."
elif [ "$tree_unknown" -eq 1 ]; then
  echo "  This verdict does not record which tree it measured, and a commit was made after it was written, so whether it describes the current code is unknown from here."
fi

# A run whose files changed underneath it did not measure what it appears to.
# On 14 August a tree edited mid-run produced 39 "Deleting old coverage for
# changed file" lines and a figure that read as a catastrophic regression -
# 100 down to 50 - when nothing had regressed at all. Devel::Cover says so
# plainly in the report; nothing else does.
# ...and only if the report belongs to THIS run. During a run the report file on
# disk is the PREVIOUS run's, so reading it unconditionally would report a stale
# discard count - the identical stale-artifact trap already guarded against for
# the verdict file two lines above, which I failed to carry over when adding this.
REPORT=${DD_GATE_REPORT:-$DD_STATE_DIR/gate2-report.txt}
if [ -f "$REPORT" ] && [ ! "$REPORT" -ot "$LOG" ]; then
  discarded=$(grep -c "Deleting old coverage for changed file" "$REPORT" 2>/dev/null)
  if [ "${discarded:-0}" -gt 0 ]; then
    echo "  INVALID: $discarded files had their coverage DISCARDED because they changed while the gate ran."
    echo "  This figure did not measure the tree it reports on. Re-run on a stable tree; do not act on it."
    exit 2
  fi
fi

# THE EXIT STATUS MUST AGREE WITH THE VERDICT (DD-569).
#
# Until now this script's last statement was `tail -2 "$VERDICT"`, so it fell off
# the end and exited with TAIL's success - 0 - while printing GATE_EXIT=1. The one
# field a caller cannot mangle by truncation was contradicting the tool's own
# printed answer, and board-pulse read PASS from a failing gate all night. A
# summary can be misread; an exit status that is simply wrong cannot be recovered
# from by any caller, however careful.
gate_exit=$(grep -oE 'GATE_EXIT=[0-9]+' "$VERDICT" 2>/dev/null | tail -1 | cut -d= -f2)
if [ -n "${gate_exit:-}" ] && [ "$gate_exit" -ne 0 ]; then
  exit 1
fi

# Stale is not passing either. Exiting 0 here would let a forty-hour-old 100.0
# stand in for a verdict on the current tree, which is the whole defect.
if [ "$tree_stale" -eq 1 ] || [ "$tree_unknown" -eq 1 ]; then
  exit 2
fi

exit 0
