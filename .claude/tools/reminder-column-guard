#!/usr/bin/env perl

# reminder-column-guard - DD-510
#
# The card reminder chases cards that have stopped moving. It decides what to
# chase from one per-column flag, `watched`, and the flag lives in this board's
# own config rather than in the reminder's code. That makes the correct
# behaviour a property of DATA, and data has no test unless something asserts
# it - so this is that something.
#
# What went wrong without it: `discard` sent 14 reminders across 2 cards, and
# `done-not-released` sent 136 across 33, all recorded in the board's own
# notification.db. A discarded card is abandoned by definition, so no reminder
# about it can ever be acted on; it escalates forever and teaches whoever reads
# the reminders to ignore all of them, including the ones that matter.
#
# Why a card in `discard` is the WORST case rather than a marginal one: the
# reminder only measures cards it can measure, and a card that has never moved
# has no move stamp, so it is never chased. Discarding a card IS a move. The
# single action that ends a card's life is also the action that starts its
# reminder clock.
#
# Why this guards data instead of fixing the emitter: the emitter lives in
# ~/.developer-dashboard/skills/tira, which is ONE installed copy shared with a
# second collector serving /home/mv/.tira/mt5 - a system this project has been
# told explicitly not to touch. Editing it there would silently change that
# system's reminders. The upstream defect is recorded on its own card instead;
# see the POD below.

use strict;
use warnings;

use File::Basename qw(dirname);
use File::Spec;
use JSON::XS;
use Capture::Tiny qw(capture);

use constant {
    EXIT_CLEAN    => 0,
    EXIT_FINDINGS => 1,
    EXIT_UNUSABLE => 3,
};

# A card in one of these columns is finished with, one way or the other. Nobody
# can act on a reminder about it, so a reminder about it is pure noise.
#
# `done-not-released` is here on judgement, not on instruction: DD-510 names
# only discard and release-to-pause. The distinction drawn against
# `blocked-by-michael` below is that a card there has a specific unanswered
# question that the agent must keep in front of the owner, whereas a card in
# `done-not-released` is finished and waits only on a release command the owner
# runs on their own schedule. Chasing the agent about the second cannot move it.
my @NEVER_REMIND = qw(discard release-to-pause done-not-released);

# The other half of the rule, and the reason this is a guard and not a mute
# switch. Silencing terminal columns is only correct if the columns that DO need
# a person are still loud - otherwise the fix for noise is just deafness.
my @MUST_REMIND = qw(blocked-by-michael);

my @BOARD_TYPES = qw(sow epic ticket);

# Purpose: resolve the d2 entrypoint from this script's own location rather than
#          from PATH, for the same reason ft99-sweep does - a scheduled run has
#          a different PATH from an interactive one.
# Input:   none
# Output:  absolute path to d2, or undef when it is not there
sub locate_d2 {
    my $root = File::Spec->rel2abs(
        File::Spec->catdir( dirname( File::Spec->rel2abs(__FILE__) ), File::Spec->updir, File::Spec->updir ) );
    my $d2 = File::Spec->catfile( $root, 'bin', 'd2' );
    return -x $d2 ? ( $d2, $root ) : ( undef, $root );
}

# Purpose: extend PERL5LIB with the operator's local library, because d2 loads
#          the product's dependencies from there and cron exports no PERL5LIB.
# Input:   none
# Output:  none; PERL5LIB is extended in place
sub ensure_library_path {
    my $home = $ENV{HOME};
    return if !defined $home || $home eq '';

    my $local_lib = File::Spec->catdir( $home, 'perl5', 'lib', 'perl5' );
    return if !-d $local_lib;

    my $current = $ENV{PERL5LIB};
    return if defined $current && grep { $_ eq $local_lib } split /:/, $current;

    $ENV{PERL5LIB} = defined $current && length $current ? "$local_lib:$current" : $local_lib;
    return;
}

# Purpose: read one board's columns THROUGH the CLI rather than by parsing
#          config.yml directly.
#
#          This is the whole point of the check and not an implementation
#          detail. Tira resolves an ABSENT `watched` key to watched=1
#          (Tira.pm:939), and `project_new` writes the `discard` column with no
#          such key at all - so on a fresh board the flag that matters is not
#          in the file. A guard that read the YAML would see nothing wrong and
#          report clean on exactly the board that has the defect.
#
# Input:   $d2 path, $type (sow|epic|ticket)
# Output:  array ref of column hashes; dies with a readable reason on failure
sub load_columns {
    my ( $d2, $type ) = @_;

    my @project = defined $ENV{DD_REMINDER_BOARD} && length $ENV{DD_REMINDER_BOARD}
      ? ( '--project', $ENV{DD_REMINDER_BOARD} ) : ();

    my ( $stdout, $stderr, $exit ) = capture {
        system( $d2, 'tira.column.list', '--type', $type, @project, '-o', 'json' );
    };
    die "cannot read the $type columns: $stderr\n" if $exit != 0;

    my $columns = eval { decode_json($stdout) };
    die "cannot parse the $type columns as JSON\n" if !$columns || ref $columns ne 'ARRAY';
    return $columns;
}

# Purpose: read the project's own notify_after, which is the limit a column
#          falls back to when it does not set one.
#
#          Needed because `watched` alone decides nothing. dwell_list only ever
#          considers a column it has a limit for - `$limit{...} = $minutes if
#          defined $minutes` - so a watched column with no limit of its own and
#          no project default is skipped in silence. That combination LOOKS
#          correct in the config and chases nobody, which is the failure mode
#          this guard would otherwise have blessed: it was caught only because
#          a scratch board built without a project default reported a watched
#          `blocked-by-michael` and still sent no reminder.
#
# Input:   $d2 path
# Output:  the project's notify_after, or undef when it has none
sub project_default_limit {
    my ($d2) = @_;

    my @project = defined $ENV{DD_REMINDER_BOARD} && length $ENV{DD_REMINDER_BOARD}
      ? ( '--project', $ENV{DD_REMINDER_BOARD} ) : ();

    my ( $stdout, $stderr, $exit ) = capture {
        system( $d2, 'tira.project.show', @project, '-o', 'json' );
    };
    die "cannot read the project settings: $stderr\n" if $exit != 0;

    my $project = eval { decode_json($stdout) };
    die "cannot parse the project settings as JSON\n" if !$project || ref $project ne 'HASH';
    return $project->{notify_after};
}

# Purpose: apply both halves of DD-510's acceptance to one board.
# Input:   $type, array ref of column hashes, the project's default limit
# Output:  list of finding strings, empty when the board is correct
sub findings_for {
    my ( $type, $columns, $default_limit ) = @_;
    my %by_name = map { $_->{name} => $_ } @{$columns};
    my @findings;

    for my $name (@NEVER_REMIND) {
        my $column = $by_name{$name} or next;    # a board need not have every column
        push @findings,
          "$type/$name is WATCHED — a card there is terminal and will be chased forever "
          . '(set watched:false, or restore it if something cleared the flag)'
          if $column->{watched};
    }

    for my $name (@MUST_REMIND) {
        my $column = $by_name{$name};
        push @findings, "$type/$name is missing — the column a person must act on does not exist on this board"
          and next
          if !$column;
        push @findings,
          "$type/$name is NOT watched — a card waiting on the owner would go unchased, "
          . 'which is the opposite failure to the one this guard exists to prevent'
          and next
          if !$column->{watched};

        # Watched but unmeasured is watched in name only.
        push @findings,
          "$type/$name is watched but has NO limit — neither the column nor the project sets "
          . 'notify_after, so the reminder skips it in silence and the column reads as correct '
          . 'in the config while chasing nobody'
          if !defined( $column->{notify_after} // $default_limit );
    }

    return @findings;
}

sub main {
    ensure_library_path();

    my ( $d2, $root ) = locate_d2();
    if ( !$d2 ) {
        say_err('reminder-column-guard: UNUSABLE — cannot find bin/d2 relative to this script');
        return EXIT_UNUSABLE;
    }
    chdir $root or do {
        say_err("reminder-column-guard: UNUSABLE — cannot enter the project root $root: $!");
        return EXIT_UNUSABLE;
    };

    my $default_limit = eval { project_default_limit($d2) };
    if ($@) {
        my $error = $@;
        chomp $error;
        say_err("reminder-column-guard: UNUSABLE — $error");
        return EXIT_UNUSABLE;
    }

    my @findings;
    for my $type (@BOARD_TYPES) {
        my $columns = eval { load_columns( $d2, $type ) };
        if ( !$columns ) {
            my $error = $@ || 'unknown failure';
            chomp $error;
            say_err("reminder-column-guard: UNUSABLE — $error");
            return EXIT_UNUSABLE;
        }
        push @findings, findings_for( $type, $columns, $default_limit );
    }

    if (@findings) {
        say_err("reminder-column-guard: $_") for @findings;
        return EXIT_FINDINGS;
    }

    print "reminder-column-guard: clean — terminal columns are silent, blocked-by-michael is not\n";
    return EXIT_CLEAN;
}

sub say_err { print STDERR "$_[0]\n"; return }

exit main() if !caller;
1;

__END__

=head1 NAME

reminder-column-guard - assert the card reminder's treatment of terminal columns

=head1 SYNOPSIS

  .claude/tools/reminder-column-guard
  DD_REMINDER_BOARD=/path/to/board .claude/tools/reminder-column-guard

=head1 DESCRIPTION

Checks every board type (sow, epic, ticket) against DD-510's acceptance:

=over

=item * a card in C<discard> or C<release-to-pause> does not appear on a reminder;

=item * a card in C<blocked-by-michael> still does, because that is a card
somebody must act on.

=back

Exit status is 0 when the board is correct, 1 when it is not, and 3 when the
board could not be read at all - the last kept distinct on purpose, because a
checker that cannot look is not the same as a board with nothing wrong.

C<DD_REMINDER_BOARD> points the guard at another board, which is how its own
failing case is exercised without editing the real one.

=head1 THE UPSTREAM DEFECT THIS DOES NOT FIX

The board data is only half the story. C<Tira::project_new> creates the
C<discard> column with no C<watched> key, and C<Tira::column_list> resolves an
absent key to watched=1, so B<every newly created Tira board chases its own
discarded cards from the moment the first card is discarded>. This board is
correct only because the flag was set on it explicitly, after the fact.

That fix belongs in C<~/.developer-dashboard/skills/tira>, which is a single
installed copy shared with the collector serving C</home/mv/.tira/mt5>. Editing
it would silently change the reminders of a system this project was told not to
touch, so it is recorded as its own card rather than done quietly here.

=cut
