#!/usr/bin/env bash
# run-suite - run the full test suite and ALWAYS mark the log when it ends.
#
# WHY THIS EXISTS (DD-579)
#   gate-status decides a run is in progress when the log carries no SUITE_EXIT
#   marker. That is true of a run that is going and of one that was killed, so a
#   suite stopped at 04:33 on 2026-08-17 was still reported as RUNNING five
#   minutes later, on the board's headline indicator.
#
#   The fix belongs in the RUNNER, not the reader. gate-status's own header
#   records that process-based detection was tried and failed in both directions
#   in a single evening - a pattern loose enough to match the searching command
#   reported a finished gate as running for 28 minutes, and one tight enough to
#   match nothing reported a running gate as finished. Teaching the reader to
#   guess would repeat a recorded mistake in order to fix a smaller one.
#
#   So the log tells the truth instead: a marker on every exit path, including
#   signals. Then "no marker" means genuinely running, and nothing has to infer.
#
#   It also removes an ad-hoc command. The runner had been retyped by hand all
#   night, which is exactly why the marker was conditional on remembering to
#   append it - the correctness now lives in a file rather than in whoever types.
#
# Exit codes:
#     0  the suite passed
#     1  the suite failed - the log carries its real status
#     2  usage error
#   130  interrupted (SIGINT), and the log says so
#   143  terminated (SIGTERM), and the log says so

set -uo pipefail

# ARTIFACT PATHS ARE PER-CHECKOUT, NOT PER-MACHINE (DD-652).
#
# These defaulted to a fixed /tmp name shared by every sandbox, worktree and
# session on the host. Measured: a coverage run in one sandbox completed with
# GATE_EXIT=0 and its verdict was already gone, overwritten by another sandbox's
# run seven minutes earlier - and the two were indistinguishable by content,
# because TREE records HEAD's tree and two sandboxes on the same commit produce
# the same hash while carrying different uncommitted work, which is what a
# sandbox gate actually grades.
#
# Deriving from this script's own location makes each checkout independent with
# no git call and no configuration - the same shape gate-status already uses for
# cover_db. The DD_* environment overrides still win, so anything that set them
# explicitly is unaffected.
_dd_here="$(cd "$(dirname "$0")" && pwd)" || {
  echo "$(basename "$0"): cannot resolve my own location; refusing to guess a state directory" >&2
  exit 3
}
DD_STATE_DIR="$(dirname "$_dd_here")/state"
mkdir -p "$DD_STATE_DIR" || {
  echo "$(basename "$0"): cannot create $DD_STATE_DIR" >&2
  exit 3
}
LOG=${DD_SUITE_LOG:-$DD_STATE_DIR/gate2.log}
PROVE=${DD_SUITE_PROVE:-prove}
ARGS=${DD_SUITE_ARGS:--lr t}

if [ "$#" -gt 0 ]; then
  printf 'Usage: %s   (configure via DD_SUITE_LOG, DD_SUITE_PROVE, DD_SUITE_ARGS)\n' "$0" >&2
  exit 2
fi

# The product's dependencies live in the operator's local library tree, and
# PERL5LIB is exported only by interactive shell init - so a scheduled or
# non-interactive run needs it set here. Four rounds on this project have lost
# time to a bare prove failing on "Can't locate Plack/Runner.pm" and reading like
# a code regression.
if [ -d "$HOME/perl5/lib/perl5" ]; then
  case "${PERL5LIB:-}" in
    *"$HOME/perl5/lib/perl5"*) : ;;
    *) PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:$PERL5LIB}"; export PERL5LIB ;;
  esac
fi

marked=0

# Purpose: append the marker exactly once, whatever ended the run.
# Input:   the status to record
# Output:  none; the log gains its final line
mark() {
  [ "$marked" -eq 1 ] && return 0
  marked=1
  printf 'SUITE_EXIT=%s\n' "$1" >> "$LOG"
}

# The child is killed FIRST, then the marker is written. Bash defers a trap until
# the foreground command returns, so an earlier version of this ran prove in the
# foreground and took 19 seconds to honour a TERM against a 20-second stand-in -
# which against the real 13-minute suite would have meant a TERM taking 13
# minutes. The tool would have made stopping a run exactly as slow as the run,
# defeating the reason for stopping it. prove is therefore backgrounded and
# waited on, because `wait` IS interruptible.
on_signal() {
  local sig="$1" code="$2"
  # THE WHOLE PROCESS GROUP, NOT JUST THE CHILD (DD-581, found in
  # production). `kill -TERM "$child"` reaches the direct child and nothing
  # beneath it. prove spawns a test process per file, so a TERM killed the
  # wrapper, wrote a verdict saying the run had stopped, and left the
  # instrumented suite running for ten more minutes - consuming the host while
  # the board reported the run as finished. A leftover process that nobody
  # believes is running is worse than one nobody stopped.
  #
  # The child is started with setsid so it leads its own group, and the negative
  # PID signals that whole group. The spec spawns a GRANDCHILD to prove it: the
  # earlier stand-in was a bare sleep, which IS the direct child, so it could
  # never have caught this.
  [ -n "${child:-}" ] && { kill -TERM "-$child" 2>/dev/null || kill -TERM "$child" 2>/dev/null; }
  printf '\n--- run-suite: killed by %s; the suite did NOT finish and this log is not a verdict ---\n' "$sig" >> "$LOG"
  mark "$code"
  exit "$code"
}

trap 'on_signal INT 130' INT
trap 'on_signal TERM 143' TERM
trap 'on_signal HUP 129' HUP

: > "$LOG"
# stdbuf keeps the log growing line by line. Without it a redirected prove buffers
# in blocks, and a log frozen at five files while the suite is at forty-four reads
# exactly like a stall - which nearly killed a healthy run on this project once.
setsid stdbuf -oL "$PROVE" $ARGS >> "$LOG" 2>&1 &
child=$!
wait "$child"
status=$?
mark "$status"
exit "$status"
